node_modules/
npm-debug.log*

# State, not source. `var/` is the raw store, run log, audit trail, dispatches,
# evaluations and fired-rule history — everything the app writes and nothing it
# reads from version control. Committing it would mean every clone and every
# deploy resurrects one machine's data, including its audit trail.
var/
var-backups/

# Secrets. LEADINTEL_SECRET signs session cookies; a committed one is not a
# secret.
.env
.env.*
!.env.example

# Vercel's project link and the env file it pulls. `.env.local` carries
# DATABASE_URL, which is a credential for the store the app now runs on.
.vercel/

*.log

# Local copy of CRON_SECRET, used to exercise the sync route by hand.
.cron-secret.local
