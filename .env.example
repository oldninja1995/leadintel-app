# Copy to .env for local work, or set these as variables on the platform.
# Production refuses to start if the first three are wrong — see server.js.

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, sessions last until the process restarts and are not shared
# between instances.
LEADINTEL_SECRET=

# Turns on HSTS and the Secure flag on the session cookie. Set this wherever
# TLS terminates in front of the app — on Railway, Render and Fly that is the
# platform, so it is `on` even though the app itself speaks plain HTTP.
LEADINTEL_TLS=on

# How many proxy hops to trust, so rate limiting keys on the visitor rather
# than on the proxy. One for a single platform load balancer.
LEADINTEL_PROXIES=1

# Set by the platform. Left here so it is obvious the app reads it.
# PORT=3000

# --- optional ---

# `static` (authored content) or `ingested` (figures derived from the raw
# store). Default: static.
# LEADINTEL_REPO=static

# `fixture` reads the synthetic payloads in lib/ingest/fixtures; `http` is the
# live transport, which throws with its reason because there are no
# credentials for any of the five sources. Default: fixture.
# LEADINTEL_TRANSPORT=fixture

# Silence the sync loop or the alert rules without stopping the other.
# LEADINTEL_SYNC=off
# LEADINTEL_ALERTS=off

# Serves as Owner with no sign-in, for working on the screens. Refused when
# NODE_ENV=production.
# LEADINTEL_AUTH=off
