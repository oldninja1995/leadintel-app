<%# Horizontal bar list for lib/marketing-insights.js: rows of
    { label, value, sub, w, colour, badge?, pop }. %>
<div style="display:flex; flex-direction:column; gap:8px;">
  <% (rows || []).forEach(function (r) { %>
    <div class="li-pop-mark" title="<%= r.label %> · <%= r.value %><%= r.sub ? ' · ' + r.sub : '' %>" data-li-pop="<%= JSON.stringify(r.pop) %>" tabindex="0" role="button">
      <div style="display:flex; align-items:baseline; gap:8px; font-size:11.5px; margin-bottom:3px; min-width:0;">
        <% if (r.badge) { %><span style="flex:none; font-size:10px; font-weight:600; color:var(--color-accent-300); border:1px solid var(--color-accent-800); border-radius:4px; padding:0 4px;"><%= r.badge %></span><% } %>
        <span style="flex:1; min-width:0; color:var(--color-neutral-400); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= r.label %></span>
        <% if (r.sub) { %><span style="flex:none; font-size:10px; color:var(--color-neutral-600); white-space:nowrap;"><%= r.sub %></span><% } %>
        <span style="flex:none; min-width:44px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-200);"><%= r.value %></span>
      </div>
      <div style="height:6px; border-radius:3px; background:var(--color-neutral-900);"><div style="height:6px; border-radius:3px; width:<%= r.w %>; background:<%= r.colour || 'var(--color-accent-500)' %>;"></div></div>
    </div>
  <% }); %>
</div>
