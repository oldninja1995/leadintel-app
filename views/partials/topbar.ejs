<!-- Top bar -->
    <header style="flex:none; display:flex; flex-wrap:wrap; row-gap:8px; align-items:center; gap:10px; padding:10px 18px; border-bottom:1px solid var(--color-neutral-900);">
      <div class="hv-6" data-action="toggleWs" style="position:relative; flex:none; display:flex; align-items:center; gap:8px; white-space:nowrap; border:1px solid var(--color-neutral-800); border-radius:8px; padding:6px 10px; cursor:pointer;">
        <div style="width:20px; height:20px; border-radius:5px; background:linear-gradient(135deg, var(--color-accent-800), var(--color-accent-600)); display:grid; place-items:center; font-size:10px; font-weight:600; color:var(--color-accent-100);">PH</div>
        <span style="font-size:12.5px; font-weight:500;">Parakkat Hospitality</span>
        <i class="ph ph-caret-up-down" style="font-size:12px; color:var(--color-neutral-600);"></i>
        <% if (wsOpen) { %>
          <div style="position:absolute; top:calc(100% + 6px); left:0; z-index:60; width:240px; background:var(--color-surface); border-radius:10px; box-shadow:var(--shadow-md); padding:6px; animation:li-pop .16s ease;">
            <div style="font-size:10px; letter-spacing:.08em; color:var(--color-neutral-600); padding:6px 8px 4px;">WORKSPACES</div>
            <div style="display:flex; align-items:center; gap:8px; padding:7px 8px; border-radius:7px; background:var(--color-accent-900);"><div style="width:18px;height:18px;border-radius:4px;background:linear-gradient(135deg,var(--color-accent-800),var(--color-accent-600));"></div><span style="flex:1; font-size:12px;">Parakkat Hospitality</span><i class="ph ph-check" style="color:var(--color-accent-300); font-size:13px;"></i></div>
            <div class="hv-1" style="display:flex; align-items:center; gap:8px; padding:7px 8px; border-radius:7px; cursor:pointer;"><div style="width:18px;height:18px;border-radius:4px;background:var(--color-neutral-800);"></div><span style="flex:1; font-size:12px; color:var(--color-neutral-400);">Coastal Escapes Group</span></div>
            <div class="hv-1" style="display:flex; align-items:center; gap:8px; padding:7px 8px; border-radius:7px; cursor:pointer; color:var(--color-neutral-500);"><i class="ph ph-plus" style="font-size:13px;"></i><span style="font-size:12px;">New workspace</span></div>
          </div>
        <% } %>
      </div>
      <div style="display:flex; flex:none; border:1px solid var(--color-neutral-800); border-radius:8px; overflow:hidden; white-space:nowrap;">
        <% (ranges || []).forEach(function (r) { %>
          <div class="hv-5" data-action="<%= r.go %>" style="padding:6px 11px; font-size:11.5px; cursor:pointer; color: <%= r.color %>; background: <%= r.bg %>; border-right:1px solid var(--color-neutral-900);"><%= r.label %></div>
        <% }); %>
        <div style="display:flex; align-items:center; gap:6px; padding:6px 11px; font-size:11.5px; color:var(--color-neutral-500);" title="The window the numbers on this screen are computed over"><i class="ph ph-calendar-blank" style="font-size:13px;"></i><%= typeof rangeLabel === 'string' ? rangeLabel : 'All time' %></div>
      </div>
      <div style="font-size:11px; flex:none; white-space:nowrap; color:var(--color-neutral-600); display:flex; align-items:center; gap:5px;"><i class="ph ph-arrows-left-right" style="font-size:12px;"></i>vs previous period</div>
      <%# **The right-hand controls are one flex item, not five.**

           The header wraps, and a wrapping flex line is filled at each item's
           *base* size — shrinking only happens afterwards, within a line. So the
           avatar, being last, dropped to a second row while the search box beside
           it still sat at its full 220px, perfectly able to give up the 40 pixels
           that would have kept the row whole. The user profile "went down".

           Grouped, the cluster is a single item that shrinks internally: the
           search box narrows to its 110px floor before anything can leave the
           row, and the profile cannot be orphaned from the button beside it.
           `min-width:0` is what lets that shrink actually happen. %>
      <div style="flex:1 1 auto; min-width:0; display:flex; flex-wrap:nowrap; justify-content:flex-end; align-items:center; gap:10px;">
      <div class="hv-6" data-action="openPalette" style="display:flex; align-items:center; gap:8px; border:1px solid var(--color-neutral-800); border-radius:8px; padding:6px 12px; flex:0 1 220px; min-width:110px; overflow:hidden; color:var(--color-neutral-600); cursor:pointer;">
        <i class="ph ph-magnifying-glass" style="font-size:13px;"></i><span style="flex:1; font-size:12px;">Search anything…</span><span style="font-size:10px; border:1px solid var(--color-neutral-800); border-radius:4px; padding:1px 5px; font-family:ui-monospace,monospace;">⌘K</span>
      </div>
      <div class="hv-16" data-action="toggleTheme" data-li-theme-toggle style="width:32px; height:32px; border:1px solid var(--color-neutral-800); border-radius:8px; display:grid; place-items:center; cursor:pointer; color:var(--color-neutral-400);" title="Switch between light and dark">
        <i class="ph ph-moon" style="font-size:16px;"></i>
      </div>
      <div class="hv-16" data-action="toggleNotif" style="position:relative; width:32px; height:32px; border:1px solid var(--color-neutral-800); border-radius:8px; display:grid; place-items:center; cursor:pointer; color:var(--color-neutral-400);">
        <i class="ph ph-bell" style="font-size:16px;"></i>
        <span style="position:absolute; top:-4px; right:-4px; min-width:15px; height:15px; border-radius:99px; background:var(--color-accent-500); color:var(--color-on-accent); font-size:9.5px; font-weight:600; display:grid; place-items:center; padding:0 3px;">4</span>
      </div>
      <div class="hv-7" data-action="toggleAi" style="display:flex; flex:none; align-items:center; gap:7px; white-space:nowrap; border:1px solid var(--color-accent-600); border-radius:8px; padding:6px 12px; cursor:pointer; color:var(--color-accent-300); background: <%= aiBtnBg %>;">
        <i class="ph-fill ph-sparkle" style="font-size:14px;"></i><span style="font-size:12px; font-weight:500;">Ask AI</span>
      </div>
      <div style="width:32px; height:32px; border-radius:99px; background:linear-gradient(135deg, var(--color-neutral-800), var(--color-neutral-700)); display:grid; place-items:center; font-size:11.5px; font-weight:600; color:var(--color-neutral-200); cursor:pointer; border:1px solid var(--color-neutral-700);" data-action="toggleProfile" title="<%= me ? me.name + ' — ' + me.roleName : 'Signed in' %>"><%= me ? me.initials : '?' %></div>
      </div>
    </header>
