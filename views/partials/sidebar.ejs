<nav style="width: <%= sidebarWidth %>; flex:none; display:flex; flex-direction:column; border-right:1px solid var(--color-neutral-900); background:linear-gradient(180deg, var(--color-bg) 0%, #14161f 100%); transition:width .22s ease; overflow:hidden;">
    <div style="display:flex; align-items:center; gap:10px; padding:16px 14px 12px; flex:none;">
      <div style="width:28px; height:28px; flex:none; border-radius:8px; border:1px solid var(--color-accent-600); display:grid; place-items:center; color:var(--color-accent-400); background:radial-gradient(120% 120% at 30% 20%, var(--color-accent-900), transparent);">
        <i class="ph-fill ph-pulse" style="font-size:16px;"></i>
      </div>
      <% if (expanded) { %>
        <div style="line-height:1.1; white-space:nowrap;">
          <div style="font-weight:600; font-size:13.5px; letter-spacing:.01em;">LeadIntel <span style="color:var(--color-accent-400);">AI</span></div>
          <div style="font-size:10px; color:var(--color-neutral-600); letter-spacing:.06em;">HOSPITALITY REVENUE OS</div>
        </div>
      <% } %>
    </div>
    <% if (expanded) { %>
      <div style="padding:2px 12px 8px; flex:none;">
        <div class="hv-14" style="display:flex; align-items:center; gap:7px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:6px 9px; color:var(--color-neutral-600); cursor:pointer;" data-action="openPalette">
          <i class="ph ph-magnifying-glass" style="font-size:13px;"></i>
          <span style="flex:1; font-size:12px;">Search…</span>
          <span style="font-size:10px; border:1px solid var(--color-neutral-800); border-radius:4px; padding:1px 5px; font-family:ui-monospace,monospace;">⌘K</span>
        </div>
      </div>
    <% } %>
    <div style="flex:1; overflow-y:auto; padding:4px 8px 12px;">
      <% (navGroups || []).forEach(function (grp) { %>
        <div style="margin-bottom:6px;">
          <% if (grp.showLabel) { %>
            <div style="font-size:10px; letter-spacing:.09em; color:var(--color-neutral-700); padding:10px 8px 4px; text-transform:uppercase; white-space:nowrap;"><%= grp.label %></div>
          <% } %>
          <% (grp.items || []).forEach(function (it) { %>
            <div class="hv-1" data-action="<%= it.go %>" title="<%= it.name %>" style="display:flex; align-items:center; gap:9px; padding:6.5px 8px; margin:1px 0; border-radius:7px; cursor:pointer; white-space:nowrap; color: <%= it.color %>; background: <%= it.bg %>; border-left:2px solid <%= it.rail %>;">
              <i class="<%= it.icon %>" style="font-size:15.5px; flex:none;"></i>
              <% if (expanded) { %>
                <span style="flex:1; font-size:12.5px; overflow:hidden; text-overflow:ellipsis;"><%= it.name %></span>
              <% } %>
              <% if (it.showBadge) { %>
                <span style="font-size:10px; background:var(--color-accent-900); color:var(--color-accent-300); border:1px solid var(--color-accent-800); border-radius:99px; padding:0 6px; line-height:15px;"><%= it.badge %></span>
              <% } %>
              <% if (it.pinned) { %>
                <i class="ph-fill ph-push-pin" style="font-size:10px; color:var(--color-neutral-700);"></i>
              <% } %>
              <%
              /* The caret carries its own data-action, and the click handler
                 takes the innermost one — so folding does not also navigate. */
              %>
              <% if ((it.children || []).length && expanded) { %>
                <i class="ph <%= it.open ? 'ph-caret-down' : 'ph-caret-right' %>"
                   data-action="toggleNav" data-nav="<%= it.slug %>"
                   title="Show or hide <%= it.children.length %> sub-screen(s)"
                   style="font-size:11px; color:var(--color-neutral-600); padding:2px; margin:-2px -2px -2px 0;"></i>
              <% } %>
            </div>
            <% if ((it.children || []).length) { %>
              <div data-nav-children="<%= it.slug %>" style="<%= it.open ? '' : 'display:none;' %>">
                <% it.children.forEach(function (kid) { %>
                  <div class="hv-1" data-action="<%= kid.go %>" title="<%= kid.name %>" style="display:flex; align-items:center; gap:9px; padding:5.5px 8px 5.5px 26px; margin:1px 0; border-radius:7px; cursor:pointer; white-space:nowrap; color: <%= kid.color %>; background: <%= kid.bg %>; border-left:2px solid <%= kid.rail %>;">
                    <i class="<%= kid.icon %>" style="font-size:13px; flex:none;"></i>
                    <% if (expanded) { %>
                      <span style="flex:1; font-size:11.5px; overflow:hidden; text-overflow:ellipsis;"><%= kid.name %></span>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            <% } %>
          <% }); %>
        </div>
      <% }); %>
    </div>
    <div style="flex:none; border-top:1px solid var(--color-neutral-900); padding:8px;">
      <div class="hv-15" data-action="toggleSidebar" style="display:flex; align-items:center; gap:9px; padding:7px 8px; border-radius:7px; cursor:pointer; color:var(--color-neutral-500); white-space:nowrap;">
        <i class="<%= collapseIcon %>" style="font-size:15px;"></i>
        <% if (expanded) { %><span style="font-size:12px;">Collapse</span><% } %>
      </div>
    </div>
  </nav>
