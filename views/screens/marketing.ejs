<div style="animation:li-fade .25s ease;">
          <div style="display:flex; align-items:baseline; gap:12px; margin-bottom:14px;">
            <h1 style="margin:0; font-family:var(--font-heading); font-weight:500; font-size:19px;">Marketing Dashboard</h1>
            <span style="font-size:11.5px; color:var(--color-neutral-600);">all platforms · CRM-verified revenue</span>
            <div style="flex:1;"></div>
            <div class="hv-3" data-action="exportCsv" title="Download this screen's tables as CSV" style="display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--color-neutral-500); border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; cursor:pointer;"><i class="ph ph-export" style="font-size:13px;"></i>Export</div>
          </div>
          <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:12px;">
            <% (mktHero || []).forEach(function (k) { %>
              <div class="hv-4"<% var drill = k.go || drillFor(k.metric); %><% if (drill) { %> data-action="<%= drill %>"<% } else { %> data-li-inert<% } %> style="background:linear-gradient(180deg, var(--color-surface), var(--color-raised)); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px 12px; cursor:pointer;">
                <div title="<%= k.tip %>" style="display:flex; align-items:center; gap:6px; font-size:10.5px; letter-spacing:.08em; color:var(--color-neutral-500); text-transform:uppercase;"><i class="<%= k.icon %>" style="font-size:13px; color:var(--color-accent-400);"></i><%= k.label %><span style="flex:1;"></span><span style="font-size:8.5px; letter-spacing:.05em; border:1px solid <%= k.srcBorder %>; border-radius:4px; padding:1px 5px; color:<%= k.srcColor %>;"><%= k.src %></span></div>
                <div style="display:flex; align-items:baseline; gap:9px; margin-top:7px;"><span style="font-size:26px; font-weight:500; font-variant-numeric:tabular-nums;"><%= k.value %></span><span style="font-size:11.5px; font-weight:500; color:<%= k.deltaColor %>;"><%= (k.delta === '—' || k.delta === '·') ? '' : k.delta %></span></div>
                <div style="font-size:10.5px; color:var(--color-neutral-600); margin-top:2px;"><%= k.sub %></div>
                <% if (k.spark) { %><svg viewBox="0 0 120 26" style="width:100%; height:26px; margin-top:8px;" preserveAspectRatio="none"><polyline points="<%= k.spark %>" fill="none" stroke="var(--color-accent-500)" stroke-width="1.6" stroke-linejoin="round" opacity="0.9"></polyline></svg><% } %>
              </div>
            <% }); %>
          </div>
          <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-bottom:12px;">
            <% (mktKpis || []).forEach(function (k) { %>
              <div class="hv-4"<% var drill = k.go || drillFor(k.metric); %><% if (drill) { %> data-action="<%= drill %>"<% } else { %> data-li-inert<% } %> title="Click to drill down · hover for benchmark" style="background:var(--color-surface); border-radius:10px; box-shadow:var(--shadow-sm); padding:9px 12px; cursor:pointer;">
                <div title="<%= k.tip %>" style="display:flex; align-items:center; gap:5px;"><span style="font-size:9.5px; letter-spacing:.06em; color:var(--color-neutral-500); text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= k.label %></span><span style="flex:1;"></span><span style="font-size:8px; border:1px solid <%= k.srcBorder %>; border-radius:4px; padding:0.5px 4px; color:<%= k.srcColor %>;"><%= k.src %></span></div>
                <div style="display:flex; align-items:baseline; gap:6px; margin-top:3px;"><span style="font-size:15px; font-weight:500; font-variant-numeric:tabular-nums;"><%= k.value %></span><span style="font-size:10px; color:<%= k.deltaColor %>;"><%= (k.delta === '—' || k.delta === '·') ? '' : k.delta %></span></div>
              </div>
            <% }); %>
          </div>
          <div style="display:grid; grid-template-columns:1.8fr 1fr; gap:12px; margin-bottom:12px;">
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
              <% var cv = (locals.mktCharts && locals.mktCharts.conversionTrend) || { empty: true }; %>
              <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:4px;">
                <div style="font-size:13px; font-weight:500;">Conversion % by platform</div>
                <span style="font-size:10.5px; color:var(--color-neutral-600);"><%= (locals.mktCharts && locals.mktCharts.grain) || '' %> · bookings ÷ CRM leads</span>
                <div style="flex:1;"></div>
                <% (cv.series || []).forEach(function (s) { %>
                  <span style="display:flex; align-items:center; gap:5px; font-size:11px; color:var(--color-neutral-400);"><span style="width:12px;height:2px;background:<%= s.colour %>;"></span><%= s.label %> <strong style="font-weight:500; color:var(--color-neutral-200);"><%= s.overallText %></strong></span>
                <% }); %>
              </div>
              <% if (cv.empty) { %>
                <div style="height:200px; display:grid; place-items:center; font-size:11.5px; color:var(--color-neutral-600); text-align:center; padding:0 24px;"><%= cv.reason %></div>
              <% } else { %>
                <svg viewBox="0 0 640 200" style="width:100%; height:200px;" preserveAspectRatio="none">
                  <g stroke="var(--color-neutral-900)" stroke-width="1"><line x1="0" y1="30" x2="640" y2="30"></line><line x1="0" y1="105" x2="640" y2="105"></line><line x1="0" y1="180" x2="640" y2="180"></line></g>
                  <% cv.series.forEach(function (s) { %>
                    <% s.paths.forEach(function (p) { %><polyline points="<%= p %>" fill="none" stroke="<%= s.colour %>" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline><% }); %>
                    <% s.dots.forEach(function (d) { %>
                      <g class="li-pop-mark" data-li-pop="<%= JSON.stringify(d.pop) %>" tabindex="0" role="button"><title><%= d.tip %></title>
                        <circle cx="<%= d.cx.toFixed(1) %>" cy="<%= d.cy.toFixed(1) %>" r="8" fill="transparent"></circle>
                        <circle cx="<%= d.cx.toFixed(1) %>" cy="<%= d.cy.toFixed(1) %>" r="3" fill="<%= d.capped ? 'var(--color-surface)' : s.colour %>" stroke="<%= s.colour %>" stroke-width="1.5" vector-effect="non-scaling-stroke"></circle>
                      </g>
                    <% }); %>
                  <% }); %>
                </svg>
                <div style="position:relative; height:14px; font-size:10px; color:var(--color-neutral-600);">
                  <% cv.axis.forEach(function (a) { %><span style="position:absolute; left:<%= (a.x / 6.4).toFixed(2) %>%; transform:translateX(-50%); white-space:nowrap;"><%= a.text %></span><% }); %>
                </div>
                <div style="font-size:10px; color:var(--color-neutral-700); padding:6px 0 0;">Top line = <%= cv.topText %>. Bookings closed in each period ÷ CRM leads that arrived in it, per platform; the figure beside each name is the whole range. Hollow points sit above the top line. Tap a point for the counts.</div>
              <% } %>
            </div>
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px; display:flex; flex-direction:column;">
              <div style="display:flex; align-items:center; margin-bottom:10px;"><div style="font-size:13px; font-weight:500;">Marketing funnel</div><div style="flex:1;"></div><span style="font-size:10px; color:var(--color-neutral-700);">bar = log scale · figures are exact</span></div>
              <div style="flex:1; display:flex; flex-direction:column; gap:9px; justify-content:center;">
                <% (mktFunnel || []).forEach(function (s) { %>
                  <div>
                    <div style="display:flex; justify-content:space-between; font-size:11px; margin-bottom:3px;"><span style="color:var(--color-neutral-400);"><%= s.label %></span><span style="font-variant-numeric:tabular-nums;"><span style="color:var(--color-neutral-200); font-weight:500;"><%= s.n %></span> <span style="color:var(--color-neutral-600);">· <%= s.pct %></span></span></div>
                    <div style="height:8px; border-radius:99px; background:var(--color-neutral-900); overflow:hidden;"><div style="height:100%; width:<%= s.w %>; border-radius:99px; background:linear-gradient(90deg, var(--color-accent-700), var(--color-accent-400));"></div></div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
          <%- include('../partials/dash-charts', { set: 'mkt', charts: locals.mktCharts }) %>
          <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
            <div style="display:flex; align-items:center; margin-bottom:8px;"><div style="font-size:13px; font-weight:500;">Platform comparison</div><span style="font-size:10.5px; color:var(--color-neutral-600); margin-left:8px;">CRM-attributed · <%= typeof rangeLabel === "string" ? rangeLabel : "all time" %> · bookings closed in this range, as Funnel Analytics counts them. The tiles above also add GA4 website revenue.</span><div style="flex:1;"></div><a href="#" style="font-size:11px;">Attribution →</a></div>
            <table style="width:100%; border-collapse:collapse; font-size:12px;">
              <thead><tr style="color:var(--color-neutral-600); font-size:10.5px; text-align:left;"><th style="padding:7px 8px 7px 0; font-weight:500;">PLATFORM</th><th style="padding:7px 8px; text-align:right; font-weight:500;">SPEND</th><th style="padding:7px 8px; text-align:right; font-weight:500;">REVENUE</th><th style="padding:7px 8px; text-align:right; font-weight:500;">BOOKINGS</th><th style="padding:7px 8px; text-align:right; font-weight:500;" title="Bookings from returning customers: the lead was marked Re-enquiry in TeleCRM, or the same phone enquired before">RC BOOKINGS</th><th style="padding:7px 8px; text-align:right; font-weight:500;">ROAS</th><th style="padding:7px 8px; text-align:right; font-weight:500;">NET ROAS</th><th style="padding:7px 8px; text-align:right; font-weight:500;">MER</th><th style="padding:7px 8px; text-align:right; font-weight:500;">CPA</th><th style="padding:7px 8px; text-align:right; font-weight:500;">CPL</th><th style="padding:7px 8px; font-weight:500;">TREND</th><th style="padding:7px 0 7px 8px; font-weight:500;">AI RECOMMENDATION</th></tr></thead>
              <tbody>
                <% (platforms || []).forEach(function (p) { %>
                  <tr class="hv-1" style="border-top:1px solid var(--color-neutral-900); cursor:pointer;">
                    <td style="padding:8.5px 8px 8.5px 0; color:var(--color-neutral-200); font-weight:500;"><span style="display:flex; align-items:center; gap:8px;"><i class="<%= p.icon %>" style="font-size:15px; color:var(--color-accent-400);"></i><%= p.name %></span></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= p.spend %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-200);"><%= p.rev %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= p.bookings %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= p.rcBookings %><% if (p.rcRev && p.rcBookings !== '0' && p.rcBookings !== p.rcRev) { %> <span style="color:var(--color-neutral-600);">· <%= p.rcRev %></span><% } %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= p.roas %></td>
                    <td style="padding:8.5px 8px; text-align:right;"><span style="font-weight:500; font-variant-numeric:tabular-nums; color:<%= p.netColor %>;"><%= p.netRoas %></span></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= p.mer %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= p.cpa %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= p.cpl %></td>
                    <td style="padding:8.5px 8px;"><svg viewBox="0 0 60 18" style="width:60px; height:18px;"><polyline points="<%= p.spark %>" fill="none" stroke="var(--color-accent-500)" stroke-width="1.4"></polyline></svg></td>
                    <td style="padding:8.5px 0 8.5px 8px;"><span style="font-size:10.5px; border:1px solid <%= p.recBorder %>; border-radius:5px; padding:2px 8px; color:<%= p.recColor %>;"><%= p.rec %></span></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
