<div style="animation:li-fade .25s ease;" data-screen-label="CRM Dashboard">
          <div style="display:flex; align-items:baseline; gap:12px; margin-bottom:14px;">
            <h1 style="margin:0; font-family:var(--font-heading); font-weight:500; font-size:19px;">CRM Dashboard</h1>
            <span style="font-size:11.5px; color:var(--color-neutral-600);">source of truth · TeleCRM + HotSoft PMS · synced 4 min ago</span>
            <div style="flex:1;"></div>
            <div class="hv-3" data-action="exportCsv" title="Download this screen's tables as CSV" style="display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--color-neutral-500); border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; cursor:pointer;"><i class="ph ph-export" style="font-size:13px;"></i>Export</div>
          </div>
          <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:12px;">
            <% (crmHero || []).forEach(function (k) { %>
              <div class="hv-4"<% var drill = k.go || drillFor(k.metric); %><% if (drill) { %> data-action="<%= drill %>"<% } else { %> data-li-inert<% } %> style="background:linear-gradient(180deg, var(--color-surface), var(--color-raised)); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px 12px; cursor:pointer;">
                <div title="<%= k.tip %>" style="display:flex; align-items:center; gap:6px; font-size:10.5px; letter-spacing:.08em; color:var(--color-neutral-500); text-transform:uppercase;"><i class="<%= k.icon %>" style="font-size:13px; color:var(--color-accent-400);"></i><%= k.label %><span style="flex:1;"></span><span style="font-size:8.5px; letter-spacing:.05em; border:1px solid <%= k.srcBorder %>; border-radius:4px; padding:1px 5px; color:<%= k.srcColor %>;"><%= k.src %></span></div>
                <div style="display:flex; align-items:baseline; gap:9px; margin-top:7px;"><span style="font-size:26px; font-weight:500; font-variant-numeric:tabular-nums;"><%= k.value %></span><span style="font-size:11.5px; font-weight:500; color:<%= k.deltaColor %>;"><%= (k.delta === '—' || k.delta === '·') ? '' : k.delta %></span></div>
                <div style="font-size:10.5px; color:var(--color-neutral-600); margin-top:2px;"><%= k.sub %></div>
                <% if (k.spark) { %><svg viewBox="0 0 120 26" style="width:100%; height:26px; margin-top:8px;" preserveAspectRatio="none"><polyline points="<%= k.spark %>" fill="none" stroke="var(--color-accent-500)" stroke-width="1.6" stroke-linejoin="round" opacity="0.9"></polyline></svg><% } %>
              </div>
            <% }); %>
          </div>
          <div style="display:grid; grid-template-columns:repeat(6,1fr); gap:10px; margin-bottom:12px;">
            <% (crmKpis || []).forEach(function (k) { %>
              <div class="hv-4"<% var drill = k.go || drillFor(k.metric); %><% if (drill) { %> data-action="<%= drill %>"<% } else { %> data-li-inert<% } %> title="<%= k.tip %>" style="background:var(--color-surface); border-radius:10px; box-shadow:var(--shadow-sm); padding:9px 12px; cursor:pointer;">
                <div style="display:flex; align-items:center; gap:5px;"><span style="font-size:9.5px; letter-spacing:.06em; color:var(--color-neutral-500); text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= k.label %></span><span style="flex:1;"></span><span style="font-size:8px; border:1px solid <%= k.srcBorder %>; border-radius:4px; padding:0.5px 4px; color:<%= k.srcColor %>;"><%= k.src %></span></div>
                <div style="display:flex; align-items:baseline; gap:6px; margin-top:3px;"><span style="font-size:15px; font-weight:500; font-variant-numeric:tabular-nums;"><%= k.value %></span><span style="font-size:10px; color:<%= k.deltaColor %>;"><%= (k.delta === '—' || k.delta === '·') ? '' : k.delta %></span></div>
              </div>
            <% }); %>
          </div>
          <div style="display:grid; grid-template-columns:1.7fr 1fr; gap:12px; margin-bottom:12px;">
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
                <div style="font-size:13px; font-weight:500;">Reservations trend</div>
                <div style="flex:1;"></div>
                <span style="display:flex; align-items:center; gap:5px; font-size:11px; color:var(--color-neutral-400);"><span style="width:8px;height:8px;border-radius:2px;background:var(--color-accent-400);"></span>Confirmed</span>
                <span style="display:flex; align-items:center; gap:5px; font-size:11px; color:var(--color-neutral-400);"><span style="width:8px;height:8px;border-radius:2px;background:var(--color-neutral-600);"></span>Cancelled</span>
              </div>
              <% var ct = locals.crmTrend || { empty: true }; %>
              <% if (ct.empty) { %>
                <div style="height:190px; display:grid; place-items:center; font-size:11.5px; color:var(--color-neutral-600);"><%= ct.reason || 'No reservations were won in this range.' %></div>
              <% } else { %>
                <div style="display:flex; gap:18px; flex-wrap:wrap; margin:4px 0 6px; font-size:11.5px; color:var(--color-neutral-500);">
                  <span><strong style="color:var(--color-neutral-200); font-weight:500;"><%= ct.totals.confirmed %></strong> confirmed · <%= ct.totals.value %></span>
                  <span><strong style="color:var(--color-neutral-200); font-weight:500;"><%= ct.totals.cancelled %></strong> cancelled</span>
                </div>
                <svg viewBox="0 0 640 190" style="width:100%; height:190px;" preserveAspectRatio="none">
                  <g stroke="var(--color-neutral-900)" stroke-width="1"><line x1="0" y1="30" x2="640" y2="30"></line><line x1="0" y1="105" x2="640" y2="105"></line><line x1="0" y1="180" x2="640" y2="180"></line></g>
                  <% ct.bars.forEach(function (b) { %>
                    <g><title><%= b.tip %></title>
                      <rect x="<%= b.confirmed.x.toFixed(1) %>" y="20" width="<%= (b.confirmed.w * 2 + 2).toFixed(1) %>" height="160" fill="transparent"></rect>
                      <rect x="<%= b.confirmed.x.toFixed(1) %>" y="<%= b.confirmed.y.toFixed(1) %>" width="<%= b.confirmed.w.toFixed(1) %>" height="<%= b.confirmed.h.toFixed(1) %>" rx="3" fill="var(--color-accent-600)"></rect>
                      <rect x="<%= b.cancelled.x.toFixed(1) %>" y="<%= b.cancelled.y.toFixed(1) %>" width="<%= b.cancelled.w.toFixed(1) %>" height="<%= b.cancelled.h.toFixed(1) %>" rx="3" fill="var(--color-neutral-700)"></rect>
                    </g>
                  <% }); %>
                </svg>
                <div style="position:relative; height:14px; font-size:10px; color:var(--color-neutral-700);">
                  <% ct.bars.forEach(function (b, i) { if (i % ct.every) return; %><span style="position:absolute; left:<%= (b.cx / 6.4).toFixed(2) %>%; transform:translateX(-50%); white-space:nowrap;"><%= b.label %></span><% }); %>
                </div>
              <% } %>
            </div>
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px; display:flex; flex-direction:column;">
              <div style="display:flex; align-items:center; margin-bottom:10px;"><div style="font-size:13px; font-weight:500;">Pipeline by stage</div><div style="flex:1;"></div><span data-action="goPipe" style="font-size:11px; color:var(--color-accent-300); cursor:pointer;">Open pipeline →</span></div>
              <div style="flex:1; display:flex; flex-direction:column; gap:8px; justify-content:center;">
                <% (crmStages || []).forEach(function (st) { %>
                  <div style="display:flex; align-items:center; gap:9px; font-size:11px;">
                    <span style="width:118px; color:var(--color-neutral-400); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= st.label %></span>
                    <div style="flex:1; height:7px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= st.w %>; border-radius:99px; background:linear-gradient(90deg, var(--color-accent-700), var(--color-accent-400));"></div></div>
                    <span style="width:26px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-300);"><%= st.n %></span>
                    <span style="width:44px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-500);"><%= st.rev %></span>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1.3fr 1fr 1fr; gap:12px;">
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
              <div style="display:flex; align-items:center; margin-bottom:8px;"><div style="font-size:13px; font-weight:500;">Sales performance</div><div style="flex:1;"></div><span data-action="goSales" style="font-size:11px; color:var(--color-accent-300); cursor:pointer;">Team →</span></div>
              <% (reps || []).forEach(function (r) { %>
                <div style="display:flex; align-items:center; gap:10px; padding:6.5px 0; border-top:1px solid var(--color-neutral-900);">
                  <div style="width:24px; height:24px; border-radius:99px; background:var(--color-neutral-800); display:grid; place-items:center; font-size:9.5px; font-weight:600; color:var(--color-neutral-300); flex:none;"><%= r.init %></div>
                  <div style="flex:1; min-width:0;"><div style="font-size:12px; color:var(--color-neutral-200);"><%= r.name %></div><div style="font-size:10.5px; color:var(--color-neutral-600);"><%= r.meta %></div></div>
                  <span style="font-size:12px; font-weight:500; font-variant-numeric:tabular-nums;"><%= r.rev %></span>
                </div>
              <% }); %>
            </div>
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
              <div style="display:flex; align-items:center; gap:7px; margin-bottom:8px;"><i class="ph ph-clock-countdown" style="color:<%= warn %>; font-size:14px;"></i><div style="font-size:13px; font-weight:500;">Follow-ups due today</div></div>
              <% (followups || []).forEach(function (f) { %>
                <div style="display:flex; align-items:center; gap:9px; padding:7px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px;">
                  <span style="width:7px; height:7px; border-radius:99px; background:<%= f.dot %>; flex:none;"></span>
                  <div style="flex:1; min-width:0;"><div style="color:var(--color-neutral-300); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= f.name %> · <%= f.what %></div><div style="font-size:10px; color:var(--color-neutral-600);"><%= f.meta %></div></div>
                  <span style="font-size:10.5px; color:var(--color-neutral-500); font-variant-numeric:tabular-nums;"><%= f.when %></span>
                </div>
              <% }); %>
            </div>
            <div style="background:linear-gradient(160deg, var(--color-section) 0%, var(--color-section-deep) 70%); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
              <div style="display:flex; align-items:center; gap:7px; margin-bottom:8px;"><i class="ph-fill ph-sparkle" style="color:var(--color-accent-300); font-size:14px;"></i><div style="font-size:13px; font-weight:500;">AI · today's priorities</div></div>
              <div style="display:flex; flex-direction:column; gap:9px; font-size:11.5px; color:var(--color-accent-100); line-height:1.5;">
                <%# Three sentences written into this template: "Call Priya K first —
                    84% booking probability, Pool Villa quote expires today (₹58.8K)",
                    twelve untouched leads to reassign from a named colleague, and a
                    cancellation rate up 2pt with "6 of 8 payment-pending". Named
                    individuals, invented probabilities, invented money, under a
                    sparkle icon. `crmRecs` is the dashboard's own derivation over the
                    same rows this screen shows. %>
                <% if (!(crmRecs || []).length) { %>
                  <div style="opacity:.75;">Nothing in range rises to a priority.</div>
                <% } %>
                <% (crmRecs || []).slice(0, 3).forEach(function (r, i) { %>
                  <div style="display:flex; gap:8px;"><span style="color:var(--color-accent-300);"><%= i + 1 %></span><span><%= r.text %><% if (r.impact) { %><span style="display:block; font-size:10.5px; opacity:.7;"><%= r.impact %></span><% } %></span></div>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
