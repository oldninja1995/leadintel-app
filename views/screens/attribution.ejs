<div style="animation:li-fade .25s ease;">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px;">
            <h1 style="margin:0; font-family:var(--font-heading); font-weight:500; font-size:19px;">Attribution</h1>
            <span style="font-size:11.5px; color:var(--color-neutral-600);">cross-channel · booking-level journeys</span>
            <div style="flex:1;"></div>
            <div style="display:flex; border:1px solid var(--color-neutral-800); border-radius:8px; overflow:hidden;">
              <% (attrModels || []).forEach(function (m) { %>
                <div class="hv-5" data-action="<%= m.go %>" style="padding:6px 11px; font-size:11px; cursor:pointer; white-space:nowrap; color:<%= m.color %>; background:<%= m.bg %>; border-right:1px solid var(--color-neutral-900);"><%= m.label %></div>
              <% }); %>
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1.5fr 1fr; gap:12px; margin-bottom:12px;">
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
              <div style="font-size:13px; font-weight:500; margin-bottom:2px;">Customer journey flow</div>
              <div style="font-size:10.5px; color:var(--color-neutral-600); margin-bottom:10px;"><%= typeof attrFlowNote !== 'undefined' && attrFlowNote ? attrFlowNote : 'width = credited revenue' %></div>
              <svg viewBox="0 0 620 240" style="width:100%; height:240px;">
                <g font-family="Inter" font-size="10">
                  <%
                  /* Drawn from data. The design typed five ribbons and five
                     revenue labels straight into this SVG, so switching the
                     credit model changed the table underneath and left the
                     picture saying whatever it had always said. */
                  var flow = (typeof attrFlow !== 'undefined' && attrFlow) ? attrFlow : [];
                  %>
                  <% flow.forEach(function (f) { %>
                    <path d="<%= f.path %>" fill="<%= f.fill %>" opacity="0.5"></path>
                  <% }); %>
                  <g>
                    <% flow.forEach(function (f) { %>
                      <rect x="40" y="<%= f.y %>" width="50" height="<%= f.h %>" rx="5" fill="<%= f.fill %>"></rect>
                      <text x="65" y="<%= f.labelY %>" text-anchor="middle" fill="var(--color-accent-100)" font-size="8.5"><%= f.label %></text>
                      <% if (f.showRev) { %>
                        <text x="65" y="<%= f.revY %>" text-anchor="middle" fill="var(--color-accent-200)" font-size="8"><%= f.rev %></text>
                      <% } %>
                    <% }); %>
                  </g>
                  <% if (!flow.length) { %>
                    <text x="310" y="120" text-anchor="middle" fill="var(--color-neutral-600)" font-size="11">No credited revenue in this range</text>
                  <% } %>
                  <g>
                    <rect x="430" y="48" width="40" height="120" rx="5" fill="var(--color-neutral-800)"></rect>
                    <text x="450" y="105" text-anchor="middle" fill="var(--color-neutral-300)" font-size="9" transform="rotate(-90 450 105)">Credited</text>
                  </g>
                  <g>
                    <rect x="560" y="80" width="46" height="78" rx="6" fill="var(--color-section-glow)"></rect>
                    <text x="583" y="112" text-anchor="middle" fill="var(--color-accent-100)" font-size="9">Booking</text>
                    <text x="583" y="126" text-anchor="middle" fill="var(--color-accent-200)" font-size="10" font-weight="500"><%= attrSankeyTotal %></text>
                  </g>
                  <text x="65" y="220" text-anchor="middle" fill="var(--color-neutral-600)" font-size="9">CHANNEL</text>
                  <text x="450" y="220" text-anchor="middle" fill="var(--color-neutral-600)" font-size="9">CREDITED</text>
                  <text x="583" y="220" text-anchor="middle" fill="var(--color-neutral-600)" font-size="9">REVENUE</text>
                </g>
              </svg>
            </div>
            <div style="display:flex; flex-direction:column; gap:12px;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
                <div style="font-size:13px; font-weight:500; margin-bottom:4px;">A real journey</div>
                <div style="font-size:10.5px; color:var(--color-neutral-600); margin-bottom:10px;"><%= typeof attrJourneyCaption !== 'undefined' ? attrJourneyCaption : '' %></div>
                <% (journey || []).forEach(function (j) { %>
                  <div style="display:flex; gap:10px; align-items:flex-start; padding-bottom:10px; position:relative;">
                    <div style="width:24px; height:24px; flex:none; border-radius:99px; border:1px solid var(--color-accent-800); background:var(--color-accent-900); display:grid; place-items:center;"><i class="<%= j.icon %>" style="font-size:12px; color:var(--color-accent-300);"></i></div>
                    <div style="flex:1;"><div style="font-size:11.5px; color:var(--color-neutral-300); line-height:1.4;"><%= j.label %></div><div style="font-size:10px; color:var(--color-neutral-600);"><%= j.when %></div></div>
                  </div>
                <% }); %>
              </div>
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px; display:flex; gap:14px;">
                <div style="flex:1;"><div style="font-size:10px; color:var(--color-neutral-600); letter-spacing:.06em;">ASSISTED CONV.</div><div style="font-size:18px; font-weight:500; margin-top:3px;"><%= typeof attrAssisted !== 'undefined' ? attrAssisted : '—' %></div><div style="font-size:10.5px; color:var(--color-neutral-600);"><%= typeof attrAssistedSub !== 'undefined' ? attrAssistedSub : '' %></div></div>
                <div style="width:1px; background:var(--color-neutral-900);"></div>
                <div style="flex:1;"><div style="font-size:10px; color:var(--color-neutral-600); letter-spacing:.06em;">AVG TIME TO BOOK</div><div style="font-size:18px; font-weight:500; margin-top:3px;"><%= typeof attrTimeToBook !== 'undefined' ? attrTimeToBook : '—' %></div><div style="font-size:10.5px; color:var(--color-neutral-600);"><%= typeof attrTimeSub !== 'undefined' ? attrTimeSub : '' %></div></div>
              </div>
            </div>
          </div>
          <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
            <div style="display:flex; align-items:center; margin-bottom:8px;"><div style="font-size:13px; font-weight:500;">Channel credit — <%= attrModelName %></div><span style="font-size:10.5px; color:var(--color-neutral-600); margin-left:8px;"><%= typeof attrCreditBasis !== 'undefined' ? attrCreditBasis : '' %></span></div>
            <table style="width:100%; border-collapse:collapse; font-size:12px;">
              <thead><tr style="color:var(--color-neutral-600); font-size:10.5px; text-align:left;"><th style="padding:7px 8px 7px 0; font-weight:500;">CHANNEL</th><th style="padding:7px 8px; text-align:right; font-weight:500;">TOUCHPOINTS</th><th style="padding:7px 8px; text-align:right; font-weight:500;">CREDITED REVENUE</th><th style="padding:7px 8px; font-weight:500;">SHARE</th><th style="padding:7px 8px; text-align:right; font-weight:500;">BOOKINGS</th><th style="padding:7px 8px; text-align:right; font-weight:500;">CONV %</th><th style="padding:7px 0 7px 8px; text-align:right; font-weight:500;">AVG TIME</th></tr></thead>
              <tbody>
                <% (attrChannels || []).forEach(function (ch) { %>
                  <tr style="border-top:1px solid var(--color-neutral-900);">
                    <td style="padding:8.5px 8px 8.5px 0; color:var(--color-neutral-200); font-weight:500;"><%= ch.channel %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= ch.tp %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-200); font-weight:500;"><%= ch.rev %></td>
                    <td style="padding:8.5px 8px; min-width:140px;"><div style="height:6px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= ch.share %>; border-radius:99px; background:linear-gradient(90deg, var(--color-accent-700), var(--color-accent-400));"></div></div></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= ch.bookings %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= ch.conv %></td>
                    <td style="padding:8.5px 0 8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= ch.time %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
