<div style="animation:li-fade .25s ease;" data-screen-label="AI Command Center">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
            <h1 style="margin:0; font-family:var(--font-heading); font-weight:500; font-size:19px;">AI Command Center</h1>
            <span style="font-size:11.5px; color:var(--color-neutral-600);">reads Meta · Google · CRM · PMS · engine · GA4 · calls · WhatsApp</span>
            <div style="flex:1;"></div>
            <div class="hv-7" data-action="toggleAi" style="display:flex; flex:none; white-space:nowrap; align-items:center; gap:6px; font-size:11.5px; color:var(--color-accent-300); border:1px solid var(--color-accent-600); border-radius:7px; padding:5px 11px; cursor:pointer;"><i class="ph-fill ph-sparkle" style="font-size:12px;"></i>Ask a question</div>
          </div>
          <div style="display:flex; gap:4px; margin-bottom:12px; border-bottom:1px solid var(--color-neutral-900); overflow-x:auto;">
            <% (aiTabs || []).forEach(function (t) { %>
              <div class="hv-5" data-action="<%= t.go %>" style="padding:8px 13px; font-size:12.5px; cursor:pointer; white-space:nowrap; color:<%= t.color %>; border-bottom:2px solid <%= t.border %>; margin-bottom:-1px;"><%= t.label %></div>
            <% }); %>
          </div>

          <!-- COMMAND CENTER -->
          <% if (aiCommand) { %>
            <div style="background:linear-gradient(160deg, var(--color-section) 0%, var(--color-section-deep) 75%); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px 18px; margin-bottom:12px;">
              <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                <i class="ph-fill ph-sparkle" style="color:var(--color-accent-300); font-size:15px;"></i>
                <div style="font-size:13px; font-weight:500;"><%= sumTitle %></div>
                <div style="flex:1;"></div>
                <div style="display:flex; border:1px solid var(--color-section-ghost); border-radius:7px; overflow:hidden;">
                  <% (sumRanges || []).forEach(function (r) { %>
                    <div class="hv-8" data-action="<%= r.go %>" style="padding:4.5px 12px; font-size:11px; cursor:pointer; color:<%= r.color %>; background:<%= r.bg %>;"><%= r.label %></div>
                  <% }); %>
                </div>
              </div>
              <div style="font-size:13px; color:var(--color-accent-100); line-height:1.65; max-width:860px;"><%= sumNarrative %></div>
              <div style="display:grid; grid-template-columns:repeat(6,1fr); gap:10px; margin-top:14px;">
                <% (sumKpis || []).forEach(function (k) { %>
                  <div style="border:1px solid var(--color-section-ghost); border-radius:9px; padding:8px 11px;">
                    <div style="font-size:9px; letter-spacing:.06em; color:var(--color-accent-2-300); opacity:.8;"><%= k.label %></div>
                    <div style="display:flex; align-items:baseline; gap:6px; margin-top:2px;"><span style="font-size:15px; font-weight:500; font-variant-numeric:tabular-nums;"><%= k.value %></span><span style="font-size:10px; color:<%= k.deltaColor %>;"><%= k.delta %></span></div>
                  </div>
                <% }); %>
              </div>
            </div>
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:12px;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
                <div style="display:flex; align-items:center; gap:7px; margin-bottom:8px;"><i class="ph ph-warning-octagon" style="color:<%= down %>; font-size:14px;"></i><div style="font-size:13px; font-weight:500;">Top risks</div></div>
                <% (aiRisks || []).forEach(function (r) { %>
                  <div style="display:flex; gap:9px; padding:8px 0; border-top:1px solid var(--color-neutral-900); align-items:flex-start;">
                    <span style="width:7px; height:7px; border-radius:99px; background:<%= r.dot %>; margin-top:5px; flex:none;"></span>
                    <div style="flex:1;"><div style="font-size:12px; color:var(--color-neutral-200); line-height:1.4;"><%= r.text %></div><div style="font-size:10.5px; color:var(--color-neutral-600); margin-top:2px;"><%= r.meta %></div></div>
                  </div>
                <% }); %>
              </div>
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
                <div style="display:flex; align-items:center; gap:7px; margin-bottom:8px;"><i class="ph ph-trend-up" style="color:<%= up %>; font-size:14px;"></i><div style="font-size:13px; font-weight:500;">Top opportunities</div></div>
                <% (aiOpps || []).forEach(function (r) { %>
                  <div style="display:flex; gap:9px; padding:8px 0; border-top:1px solid var(--color-neutral-900); align-items:flex-start;">
                    <span style="width:7px; height:7px; border-radius:99px; background:var(--color-accent-400); margin-top:5px; flex:none;"></span>
                    <div style="flex:1;"><div style="font-size:12px; color:var(--color-neutral-200); line-height:1.4;"><%= r.text %></div><div style="font-size:10.5px; color:var(--color-neutral-600); margin-top:2px;"><%= r.meta %></div></div>
                  </div>
                <% }); %>
              </div>
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
                <div style="display:flex; align-items:center; gap:7px; margin-bottom:8px;"><i class="ph ph-lightning" style="color:<%= warn %>; font-size:14px;"></i><div style="font-size:13px; font-weight:500;">Action required</div></div>
                <% (aiActions || []).forEach(function (r) { %>
                  <div style="display:flex; gap:9px; padding:8px 0; border-top:1px solid var(--color-neutral-900); align-items:center;">
                    <div style="flex:1;"><div style="font-size:12px; color:var(--color-neutral-200); line-height:1.4;"><%= r.text %></div><div style="font-size:10.5px; color:var(--color-neutral-600); margin-top:2px;"><%= r.meta %></div></div>
                    <span class="hv-7" style="flex:none; font-size:10.5px; border:1px solid var(--color-accent-700); border-radius:6px; padding:3px 10px; color:var(--color-accent-300); cursor:pointer;"><%= r.btn %></span>
                  </div>
                <% }); %>
              </div>
            </div>
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
              <div style="display:flex; align-items:center; margin-bottom:10px;"><div style="font-size:13px; font-weight:500;">Business health</div><div style="flex:1;"></div><span data-action="aiGoHealth" style="font-size:11px; color:var(--color-accent-300); cursor:pointer;">Full breakdown →</span></div>
              <div style="display:flex; align-items:center; gap:20px;">
                <svg viewBox="0 0 84 84" style="width:74px; height:74px; flex:none;">
                  <circle cx="42" cy="42" r="34" fill="none" stroke="var(--color-neutral-900)" stroke-width="8"></circle>
                  <circle cx="42" cy="42" r="34" fill="none" stroke="var(--color-accent-400)" stroke-width="8" stroke-dasharray="179.4 213.6" stroke-linecap="round" transform="rotate(-90 42 42)"></circle>
                  <text x="42" y="42" text-anchor="middle" fill="var(--color-neutral-500)" font-size="18" font-weight="500" font-family="Inter">&#8212;</text>
                  <text x="42" y="56" text-anchor="middle" fill="var(--color-neutral-600)" font-size="7" font-family="Inter">no model</text>
                </svg>
                <div style="flex:1; display:grid; grid-template-columns:repeat(4,1fr); gap:10px 18px;">
                  <% (healthMinis || []).forEach(function (h) { %>
                    <div data-action="aiGoHealth" style="cursor:pointer;">
                      <div style="display:flex; justify-content:space-between; font-size:11px; margin-bottom:3px;"><span style="color:var(--color-neutral-400);"><%= h.name %></span><span style="font-weight:500; color:<%= h.color %>; font-variant-numeric:tabular-nums;"><%= h.score %></span></div>
                      <div style="height:5px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= h.w %>; border-radius:99px; background:<%= h.color %>;"></div></div>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          <% } %>

          <!-- CHAT -->
          <% if (aiChat) { %>
            <div style="display:grid; grid-template-columns:1fr 280px; gap:12px; align-items:start;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; min-height:480px;">
                <%# This held a transcript: two questions and two answers, written into
                    the template. One named a campaign, gave it "₹6.1L profit on ₹2.1L
                    spend (94 confirmed bookings)", and closed with "Sources: Meta Ads
                    sync + CRM revenue, verified 4 min ago". The other forecast next
                    month's occupancy at 83%, "87% confidence". Nothing was read, no
                    assistant was called, and the composer beneath it went nowhere — a
                    reader had no way to tell any of that.

                    The tab stays rather than being removed, because the question it
                    poses is a real one and a missing tab reads as a feature nobody got
                    round to, while an empty one reads as the truth: not connected. %>
                <div style="flex:1; padding:32px 18px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; text-align:center;">
                  <i class="ph ph-plugs" style="font-size:22px; color:var(--color-neutral-600);"></i>
                  <div style="font-size:13px; color:var(--color-neutral-300); font-weight:500;">No assistant is connected</div>
                  <div style="font-size:11.5px; color:var(--color-neutral-500); line-height:1.6; max-width:440px;">
                    Nothing in this product answers a typed question yet. The paragraph on
                    the Command centre tab is the closest thing to it, and every figure in
                    it is counted from the same rows the screens behind it show.
                  </div>
                </div>
                <div style="flex:none; padding:12px 16px; border-top:1px solid var(--color-neutral-900);">
                  <div style="display:flex; align-items:center; gap:8px; border:1px solid var(--color-neutral-900); border-radius:9px; padding:9px 12px; opacity:.55;">
                    <input placeholder="Not connected" disabled aria-label="Ask a question — not connected" style="flex:1; background:transparent; border:none; outline:none; color:var(--color-neutral-600); font-size:12.5px; font-family:var(--font-body); cursor:not-allowed;">
                    <i class="ph-fill ph-paper-plane-right" style="color:var(--color-neutral-700); font-size:15px;"></i>
                  </div>
                </div>
              </div>
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
                <div style="font-size:12px; font-weight:500; margin-bottom:8px;">Try asking</div>
                <% (aiCaps || []).forEach(function (q) { %>
                  <div class="hv-10" style="border:1px solid var(--color-neutral-800); border-radius:8px; padding:7px 10px; font-size:11.5px; color:var(--color-neutral-400); cursor:pointer; margin-bottom:6px; line-height:1.4;"><%= q %></div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- HEALTH -->
          <% if (aiHealth) { %>
            <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px;">
              <% (healthCards || []).forEach(function (h) { %>
                <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px;">
                  <div style="display:flex; align-items:center; gap:10px;">
                    <svg viewBox="0 0 48 48" style="width:42px; height:42px; flex:none;">
                      <circle cx="24" cy="24" r="19" fill="none" stroke="var(--color-neutral-900)" stroke-width="5"></circle>
                      <circle cx="24" cy="24" r="19" fill="none" stroke="<%= h.color %>" stroke-width="5" stroke-dasharray="<%= h.dash %>" stroke-linecap="round" transform="rotate(-90 24 24)"></circle>
                      <text x="24" y="28" text-anchor="middle" fill="var(--color-neutral-200)" font-size="12" font-weight="500" font-family="Inter"><%= h.score %></text>
                    </svg>
                    <div style="flex:1;">
                      <div style="display:flex; align-items:center; gap:6px;"><i class="<%= h.icon %>" style="font-size:13px; color:var(--color-neutral-500);"></i><span style="font-size:12.5px; font-weight:500;"><%= h.name %></span></div>
                      <div style="display:flex; gap:6px; margin-top:4px;">
                        <span style="font-size:9.5px; border:1px solid var(--color-neutral-800); border-radius:4px; padding:1px 6px; color:<%= h.riskColor %>;"><%= h.risk %></span>
                        <span style="font-size:9.5px; color:<%= h.trendColor %>;"><%= h.trend %></span>
                      </div>
                    </div>
                  </div>
                  <div style="font-size:11px; color:var(--color-neutral-400); line-height:1.5; margin-top:10px; padding-top:9px; border-top:1px solid var(--color-neutral-900);"><%= h.reason %></div>
                  <div style="display:flex; flex-wrap:wrap; gap:5px; margin-top:8px;">
                    <% (h.chips || []).forEach(function (c) { %><span style="font-size:9.5px; border:1px solid var(--color-neutral-800); border-radius:5px; padding:1.5px 7px; color:var(--color-neutral-500); font-variant-numeric:tabular-nums;"><%= c %></span><% }); %>
                  </div>
                  <div style="font-size:10.5px; color:var(--color-accent-300); margin-top:9px; line-height:1.45;"><i class="ph-fill ph-sparkle" style="font-size:10px;"></i> <%= h.rec %></div>
                  <div style="font-size:9px; color:var(--color-neutral-700); margin-top:6px;">Benchmark: <%= h.bench %></div>
                </div>
              <% }); %>
            </div>
          <% } %>

          <!-- FORECAST -->
          <%# THE FORECAST TAB.

              This drew a projection: four KPI cards (₹61.0L revenue, 468 bookings,
              83% occupancy, a ₹9.6L recommended budget, each with a range), a
              horizon control offering August / Q3 / Rest of year, "confidence 89%
              · model retrained nightly on CRM + PMS actuals", and an SVG whose
              path coordinates were typed by hand — a rising actual line, a dashed
              forecast continuing it, and a widening confidence band, all fixed
              geometry that never moved whatever the data said.

              There is no forecasting model in this product. Not a weak one, none.
              A chart is the most persuasive thing on a page and this one was
              drawing a shape nothing had computed, next to a confidence figure for
              it. The horizon control is gone too: offering a choice between three
              horizons implies three answers exist.

              The tab stays, because the question is a real one and a reader should
              see it is unanswered rather than find the tab quietly missing. %>
          <% if (aiForecast) { %>
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:26px 22px;">
              <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                <i class="ph ph-chart-line-up" style="color:var(--color-neutral-600); font-size:15px;"></i>
                <div style="font-size:13px; font-weight:500;"><%= fcLabel %></div>
              </div>
              <div style="font-size:11.5px; color:var(--color-neutral-500); line-height:1.65; max-width:620px;"><%= fcNote %></div>
              <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:16px;">
                <% (fcKpis || []).forEach(function (k) { %>
                  <div style="border:1px solid var(--color-neutral-900); border-radius:10px; padding:10px 13px;">
                    <div style="font-size:9.5px; letter-spacing:.06em; color:var(--color-neutral-600); text-transform:uppercase;"><%= k.label %></div>
                    <div style="font-size:17px; font-weight:500; color:var(--color-neutral-600); margin-top:4px;"><%= k.value %></div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- ANOMALIES & ROOT CAUSE -->
          <% if (aiAnom) { %>
            <div style="display:grid; grid-template-columns:1.2fr 1fr; gap:12px; align-items:start;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:6px 16px 12px;">
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                  <thead><tr style="color:var(--color-neutral-600); font-size:10.5px; text-align:left;"><th style="padding:9px 8px 9px 0; font-weight:500;">ANOMALY</th><th style="padding:9px 8px; text-align:right; font-weight:500;">DEVIATION</th><th style="padding:9px 8px; font-weight:500;">DETECTED</th><th style="padding:9px 0 9px 8px; font-weight:500;">STATUS</th></tr></thead>
                  <tbody>
                    <% (anomalies || []).forEach(function (a) { %>
                      <tr class="hv-1" style="border-top:1px solid var(--color-neutral-900); cursor:pointer;">
                        <td style="padding:9px 8px 9px 0;"><span style="display:flex; align-items:flex-start; gap:8px;"><span style="width:7px; height:7px; border-radius:99px; background:<%= a.dot %>; margin-top:5px; flex:none;"></span><span><span style="color:var(--color-neutral-200); display:block;"><%= a.title %></span><span style="font-size:10.5px; color:var(--color-neutral-600);"><%= a.scope %></span></span></span></td>
                        <td style="padding:9px 8px; text-align:right; font-variant-numeric:tabular-nums; color:<%= a.devColor %>; font-weight:500;"><%= a.dev %></td>
                        <td style="padding:9px 8px; color:var(--color-neutral-500); white-space:nowrap;"><%= a.when %></td>
                        <td style="padding:9px 0 9px 8px;"><span style="font-size:10px; border:1px solid var(--color-neutral-800); border-radius:99px; padding:2px 8px; color:<%= a.statusColor %>; white-space:nowrap;"><%= a.status %></span></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <%# This panel drew a five-step causal chain for a cancellation spike:
                  a PMS folio status at the moment of cancellation, a missing CRM
                  reminder task, an audit-log entry naming an admin and a date. None
                  of it was read from anything, and the Command centre paragraph on
                  this same screen ends "Nothing on this page infers a cause".

                  So the chain is gone and the panel says what the table beside it is
                  and is not. Detection and explanation are different products; this
                  one detects. %>
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
                <div style="display:flex; align-items:center; gap:7px; margin-bottom:4px;"><i class="ph ph-tree-structure" style="color:var(--color-neutral-500); font-size:14px;"></i><div style="font-size:13px; font-weight:500;">No root cause</div></div>
                <div style="font-size:11.5px; color:var(--color-neutral-500); line-height:1.6;">
                  The table beside this one reports how far a day sat from its own
                  average, and over how many days that average was taken. It does not
                  say why, and nothing in this product does — the paragraph on the
                  Command centre tab ends on the same sentence.
                </div>
                <% (rootChain || []).forEach(function (rc) { %>
                  <div style="display:flex; gap:11px; align-items:flex-start;">
                    <div style="display:flex; flex-direction:column; align-items:center; align-self:stretch;">
                      <div style="width:22px; height:22px; flex:none; border-radius:99px; border:1px solid var(--color-accent-800); background:var(--color-accent-900); display:grid; place-items:center; font-size:10px; color:var(--color-accent-300); font-weight:500;"><%= rc.n %></div>
                      <% if (rc.line) { %><div style="width:1px; flex:1; min-height:14px; background:var(--color-neutral-800);"></div><% } %>
                    </div>
                    <div style="padding-bottom:14px;">
                      <div style="font-size:12px; color:var(--color-neutral-200); line-height:1.45;"><%= rc.text %></div>
                      <div style="font-size:10.5px; color:var(--color-neutral-600); margin-top:2px;"><%= rc.evidence %></div>
                    </div>
                  </div>
                <% }); %>
                <%# A "Fix:" box recommending a 48-hour payment window, "recovers an
                    estimated 5 of 8 monthly cancellations (₹1.1L)". Both the diagnosis
                    and the recovery estimate were written by hand — the second is a
                    forecast, and there is no model here for one. %>
              </div>
            </div>
          <% } %>

          <!-- SIMULATOR -->
          <% if (aiSim) { %>
            <div style="display:grid; grid-template-columns:340px 1fr; gap:12px; align-items:start;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
                <div style="font-size:13px; font-weight:500; margin-bottom:2px;">Scenario levers</div>
                <%# Was "model fitted on 12 months of CRM + ads history". Nothing was
                    fitted on anything; the levers are arithmetic over a baseline. %>
                <div style="font-size:10.5px; color:var(--color-neutral-600); margin-bottom:14px;">arithmetic over this range, not a fitted model</div>
                <div style="margin-bottom:14px;">
                  <div style="font-size:11px; color:var(--color-neutral-400); margin-bottom:6px;">Meta Ads budget</div>
                  <div style="display:flex; border:1px solid var(--color-neutral-800); border-radius:7px; overflow:hidden;">
                    <% (simMetaOpts || []).forEach(function (o) { %>
                      <div class="hv-5" data-action="<%= o.go %>" style="flex:1; text-align:center; padding:6px 0; font-size:11.5px; cursor:pointer; color:<%= o.color %>; background:<%= o.bg %>; border-right:1px solid var(--color-neutral-900);"><%= o.label %></div>
                    <% }); %>
                  </div>
                </div>
                <div style="margin-bottom:14px;">
                  <div style="font-size:11px; color:var(--color-neutral-400); margin-bottom:6px;">ADR (room rates)</div>
                  <div style="display:flex; border:1px solid var(--color-neutral-800); border-radius:7px; overflow:hidden;">
                    <% (simAdrOpts || []).forEach(function (o) { %>
                      <div class="hv-5" data-action="<%= o.go %>" style="flex:1; text-align:center; padding:6px 0; font-size:11.5px; cursor:pointer; color:<%= o.color %>; background:<%= o.bg %>; border-right:1px solid var(--color-neutral-900);"><%= o.label %></div>
                    <% }); %>
                  </div>
                </div>
                <div style="margin-bottom:14px;">
                  <div style="font-size:11px; color:var(--color-neutral-400); margin-bottom:6px;">Cancellation rate</div>
                  <div style="display:flex; border:1px solid var(--color-neutral-800); border-radius:7px; overflow:hidden;">
                    <% (simCancelOpts || []).forEach(function (o) { %>
                      <div class="hv-5" data-action="<%= o.go %>" style="flex:1; text-align:center; padding:6px 0; font-size:11.5px; cursor:pointer; color:<%= o.color %>; background:<%= o.bg %>; border-right:1px solid var(--color-neutral-900);"><%= o.label %></div>
                    <% }); %>
                  </div>
                </div>
                <%# Held a second, different set of invented coefficients — "5.1x with
                    saturation decay, −0.25pt occupancy per +1% ADR, 82% recovery" — which
                    disagreed with the ones the data file was actually calculating with.
                    The assumptions are stated once now, by the projection that applies
                    them, in `simNote` below. %>
              </div>
              <div style="background:linear-gradient(160deg, var(--color-section) 0%, var(--color-section-deep) 75%); border-radius:12px; box-shadow:var(--shadow-sm); padding:18px;">
                <%# Was "Predicted next 30 days". It is not a prediction and it is not
                    about the next 30 days: it is this range's own measured figures with
                    the levers applied. %>
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;"><i class="ph-fill ph-flask" style="color:var(--color-accent-300); font-size:15px;"></i><div style="font-size:13px; font-weight:500;">This range with the levers applied — <%= simScenario %></div></div>
                <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:10px;">
                  <% (simOut || []).forEach(function (o) { %>
                    <div style="border:1px solid var(--color-section-ghost); border-radius:10px; padding:11px 13px;">
                      <div style="font-size:9px; letter-spacing:.06em; color:var(--color-accent-2-300); opacity:.8;"><%= o.label %></div>
                      <div style="font-size:19px; font-weight:500; margin-top:4px; font-variant-numeric:tabular-nums;"><%= o.value %></div>
                      <div style="font-size:10.5px; margin-top:2px; color:<%= o.deltaColor %>; font-variant-numeric:tabular-nums;"><%= o.delta %></div>
                    </div>
                  <% }); %>
                </div>
                <div style="margin-top:14px; font-size:12px; color:var(--color-accent-100); line-height:1.6;"><%= simNote %></div>
                <div style="display:flex; gap:8px; margin-top:14px;">
                  <span class="hv-7" style="font-size:11px; border:1px solid var(--color-accent-500); border-radius:7px; padding:6px 14px; color:var(--color-accent-200); cursor:pointer;">Save scenario</span>
                  <span style="font-size:11px; border:1px solid var(--color-section-ghost); border-radius:7px; padding:6px 14px; color:var(--color-accent-2-300); cursor:pointer;">Create budget plan from this</span>
                </div>
              </div>
            </div>
          <% } %>

          <!-- GOALS & BENCHMARKS -->
          <% if (aiGoals) { %>
            <div style="display:grid; grid-template-columns:1fr 1.2fr; gap:12px; align-items:start;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
                <%# Was "July goals" and "2 days left", both fixed strings on a screen
                    whose range control moves. The heading now names what the rows
                    actually are: each metric against the target its own definition
                    in the registry declares, over the selected range. %>
                <div style="display:flex; align-items:center; margin-bottom:12px;"><div style="font-size:13px; font-weight:500;">Against target</div><div style="flex:1;"></div><span style="font-size:11px; color:var(--color-neutral-500);"><%= (goals || []).length %> metric<%= (goals || []).length === 1 ? '' : 's' %> declare one</span></div>
                <% if (!(goals || []).length) { %>
                  <div style="font-size:11.5px; color:var(--color-neutral-500); line-height:1.6; padding:6px 0 10px;">No metric in range carries both a measured value and a target. Targets live beside the definitions, in the metric registry.</div>
                <% } %>
                <% (goals || []).forEach(function (g) { %>
                  <div style="margin-bottom:13px;">
                    <div style="display:flex; align-items:baseline; gap:8px; font-size:11.5px; margin-bottom:4px;">
                      <span style="color:var(--color-neutral-300);"><%= g.name %></span>
                      <span style="flex:1;"></span>
                      <span style="font-variant-numeric:tabular-nums; color:var(--color-neutral-200); font-weight:500;"><%= g.cur %></span>
                      <span style="font-size:10px; color:var(--color-neutral-600);">/ <%= g.target %></span>
                      <span style="font-size:10px; color:<%= g.paceColor %>;"><%= g.pace %></span>
                    </div>
                    <div style="height:7px; border-radius:99px; background:var(--color-neutral-900); position:relative;">
                      <div style="height:100%; width:<%= g.w %>; border-radius:99px; background:<%= g.barColor %>;"></div>
                      <div style="position:absolute; top:-2px; bottom:-2px; left:93%; width:2px; background:var(--color-neutral-600); border-radius:2px;" title="time elapsed"></div>
                    </div>
                  </div>
                <% }); %>
              </div>
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                  <div style="font-size:13px; font-weight:500;">Benchmarks</div>
                  <div style="flex:1;"></div>
                  <div style="display:flex; border:1px solid var(--color-neutral-800); border-radius:7px; overflow:hidden;">
                    <% (benchModes || []).forEach(function (m) { %>
                      <div class="hv-5" data-action="<%= m.go %>" style="padding:5px 11px; font-size:10.5px; cursor:pointer; white-space:nowrap; color:<%= m.color %>; background:<%= m.bg %>; border-right:1px solid var(--color-neutral-900);"><%= m.label %></div>
                    <% }); %>
                  </div>
                </div>
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                  <thead><tr style="color:var(--color-neutral-600); font-size:10.5px; text-align:left;"><th style="padding:7px 8px 7px 0; font-weight:500;"><%= benchCol1 %></th><th style="padding:7px 8px; text-align:right; font-weight:500;"><%= benchCol2 %></th><th style="padding:7px 8px; text-align:right; font-weight:500;"><%= benchCol3 %></th><th style="padding:7px 8px; text-align:right; font-weight:500;">Δ</th><th style="padding:7px 0 7px 8px; font-weight:500;"></th></tr></thead>
                  <tbody>
                    <% (benchRows || []).forEach(function (b) { %>
                      <tr style="border-top:1px solid var(--color-neutral-900);">
                        <td style="padding:8px 8px 8px 0; color:var(--color-neutral-300); white-space:nowrap;"><%= b.metric %></td>
                        <td style="padding:8px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-200); font-weight:500;"><%= b.cur %></td>
                        <td style="padding:8px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-500);"><%= b.prev %></td>
                        <td style="padding:8px 8px; text-align:right; font-variant-numeric:tabular-nums; color:<%= b.deltaColor %>; font-weight:500;"><%= b.delta %></td>
                        <td style="padding:8px 0 8px 8px; min-width:90px;"><div style="height:5px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= b.w %>; border-radius:99px; background:<%= b.barColor %>;"></div></div></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } %>

          <!-- RECOMMENDATIONS -->
          <% if (aiRecsTab) { %>
          <div style="display:flex; gap:6px; margin-bottom:14px;">
            <span style="font-size:11.5px; padding:4.5px 12px; border-radius:99px; background:var(--color-accent-900); border:1px solid var(--color-accent-800); color:var(--color-accent-300);">All (9)</span>
            <span class="hv-3" style="font-size:11.5px; padding:4.5px 12px; border-radius:99px; border:1px solid var(--color-neutral-800); color:var(--color-neutral-500); cursor:pointer;">Marketing</span>
            <span class="hv-3" style="font-size:11.5px; padding:4.5px 12px; border-radius:99px; border:1px solid var(--color-neutral-800); color:var(--color-neutral-500); cursor:pointer;">Sales</span>
            <span class="hv-3" style="font-size:11.5px; padding:4.5px 12px; border-radius:99px; border:1px solid var(--color-neutral-800); color:var(--color-neutral-500); cursor:pointer;">Reservations</span>
            <span class="hv-3" style="font-size:11.5px; padding:4.5px 12px; border-radius:99px; border:1px solid var(--color-neutral-800); color:var(--color-neutral-500); cursor:pointer;">Revenue</span>
          </div>
          <div style="display:flex; flex-direction:column; gap:10px;">
            <% (aiFeed || []).forEach(function (ins) { %>
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px 16px; display:flex; gap:12px;">
                <div style="width:30px; height:30px; flex:none; border-radius:8px; border:1px solid var(--color-neutral-800); display:grid; place-items:center; color:<%= ins.color %>;"><i class="<%= ins.icon %>" style="font-size:15px;"></i></div>
                <div style="flex:1;">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:13px; font-weight:500; color:var(--color-neutral-200);"><%= ins.title %></span>
                    <span style="font-size:9.5px; letter-spacing:.05em; border:1px solid var(--color-neutral-800); border-radius:4px; padding:1px 6px; color:<%= ins.color %>;"><%= ins.cat %></span>
                  </div>
                  <div style="font-size:12px; color:var(--color-neutral-400); line-height:1.55; margin-top:4px;"><%= ins.body %></div>
                  <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap;">
                    <% (ins.chips || []).forEach(function (c) { %><span style="font-size:10.5px; border:1px solid var(--color-neutral-800); border-radius:5px; padding:2px 8px; color:var(--color-neutral-400); font-variant-numeric:tabular-nums;"><%= c %></span><% }); %>
                    <div style="flex:1;"></div>
                    <span style="font-size:11px; color:var(--color-accent-300); cursor:pointer;"><%= ins.action %> →</span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
          <div style="margin-top:12px; background:linear-gradient(160deg, var(--color-section) 0%, var(--color-section-deep) 70%); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
            <%# Four checkboxes written into the template: shift ₹40K/week to a named
                campaign, rotate two hooks on a "fatigued waterfall video", broaden a
                lookalike 2% → 4%, fix a landing page form with "58% mobile drop-off".
                None of those campaigns, videos, audiences or figures came from
                anywhere, and the list never changed whatever the account did.

                The actions the Command centre tab derives are the actions. They are
                the same list, from rows, and there are as many of them as the rows
                support — which is sometimes none, and none is a real answer. %>
            <div style="display:flex; align-items:center; gap:7px; margin-bottom:10px;"><i class="ph-fill ph-list-checks" style="color:var(--color-accent-300); font-size:15px;"></i><div style="font-size:13px; font-weight:500;">What the rows support</div></div>
            <% if (!(aiActions || []).length) { %>
              <div style="font-size:12px; color:var(--color-accent-100); opacity:.75; line-height:1.55;">Nothing in range rises to an action. That is an answer, not an empty state.</div>
            <% } else { %>
              <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:12px; color:var(--color-accent-100); line-height:1.5;">
                <% (aiActions || []).forEach(function (a) { %>
                  <div style="display:flex; gap:8px;"><i class="ph ph-square" style="margin-top:2px; color:var(--color-accent-300);"></i><span><%= a.text %><span style="display:block; font-size:10.5px; opacity:.7;"><%= a.meta %></span></span></div>
                <% }); %>
              </div>
            <% } %>
          </div>
          <% } %>
        </div>
