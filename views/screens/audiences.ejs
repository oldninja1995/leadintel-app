<div style="animation:li-fade .25s ease;">
          <div style="display:flex; align-items:baseline; gap:12px; margin-bottom:14px;">
            <h1 style="margin:0; font-family:var(--font-heading); font-weight:500; font-size:19px;">Audience Analytics</h1>
            <span style="font-size:11.5px; color:var(--color-neutral-600);">demographics, segments & saturation · CRM-verified</span>
          </div>
          <%# **Revenue by channel, from every system connected.**

               The projection has computed this for as long as the screen has
               existed and nothing rendered it — the design has no panel for it,
               so the figure that answers "where does the money come from" was
               being calculated and thrown away. It goes first: it is the
               question, and the demographics beneath it are the detail.

               Four books meet in each row — ad spend from the platforms, leads
               and won deals from the CRM, the booking engine's revenue from
               GA4, and the channels the CRM knows that no ad platform does. The
               line under each name says which of them contributed, so nobody
               has to guess where a figure came from. %>
          <% if ((typeof audRevenue !== 'undefined') && audRevenue && audRevenue.length) { %>
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px; margin-bottom:12px;">
              <div style="display:flex; align-items:baseline; gap:10px; margin-bottom:10px;">
                <div style="font-size:13px; font-weight:500;">Revenue by channel</div>
                <span style="font-size:10.5px; color:var(--color-neutral-600);">CRM deals, the booking engine's revenue where GA4 prices it, against what each channel cost</span>
              </div>
              <% audRevenue.forEach(function (c) { %>
                <div style="padding:7px 0; border-bottom:1px solid var(--color-neutral-900);">
                  <div style="display:flex; align-items:baseline; gap:10px; font-size:11.5px;">
                    <span style="width:110px; flex:none; color:var(--color-neutral-200); font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c.type %></span>
                    <div style="flex:1; height:7px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= c.w %>; border-radius:99px; background:linear-gradient(90deg, var(--color-accent-700), var(--color-accent-400));"></div></div>
                    <span style="width:72px; flex:none; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-100); font-weight:500;"><%= c.rev %></span>
                    <span style="width:38px; flex:none; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-600);"><%= c.share %></span>
                    <span style="width:46px; flex:none; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);" title="Revenue over what this channel cost. A channel with no ad spend has no return on advertising to state."><%= c.roas %></span>
                    <span style="width:52px; flex:none; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-500);" title="Won, uncancelled bookings the CRM recorded against this channel."><%= c.bookings %></span>
                  </div>
                  <div style="font-size:10px; color:var(--color-neutral-600); margin-top:3px; padding-left:120px;"><%= c.meta %></div>
                </div>
              <% }); %>
              <div style="font-size:10px; color:var(--color-neutral-600); padding-top:9px; line-height:1.5;">
                Revenue is the CRM's, plus what the booking engine took from paid-search sessions on Google's
                row — two books, and a booking in both is counted twice. Nothing can reconcile them until a PMS
                gives both one folio, so the overlap is named rather than netted away.
              </div>
            </div>
          <% } %>
          <div style="display:grid; grid-template-columns:1.6fr 1fr; gap:12px; margin-bottom:12px;">
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
              <div style="display:flex; align-items:center; margin-bottom:10px;"><div style="font-size:13px; font-weight:500;"><%= (typeof audAgeMeasure !== 'undefined' && audAgeMeasure) ? audAgeMeasure : 'Leads' %> by age &amp; gender</div><div style="flex:1;"></div><span style="display:flex; gap:10px; font-size:11px; color:var(--color-neutral-400);"><span style="display:flex; align-items:center; gap:5px;"><span style="width:8px;height:8px;border-radius:2px;background:var(--color-accent-500);"></span>Female</span><span style="display:flex; align-items:center; gap:5px;"><span style="width:8px;height:8px;border-radius:2px;background:var(--color-neutral-600);"></span>Male</span></span></div>
              <%
              /* Drawn from Meta's age x gender breakdown. The design titled this
                 "Revenue by age & gender" and drew ten fixed bars that never moved;
                 nothing in this stack reports revenue by demographic, so it counts
                 leads and the title says leads. */
              var bands = (typeof audAge !== 'undefined' && audAge) ? audAge : [];
              %>
              <% if (!bands.length) { %>
                <div style="height:130px; display:grid; place-items:center; font-size:11.5px; color:var(--color-neutral-600); text-align:center; padding:0 18px;">
                  <%= typeof audAgeNote !== 'undefined' ? audAgeNote : '' %>
                </div>
              <% } else { %>
              <svg viewBox="0 0 340 130" style="width:100%; height:130px;" preserveAspectRatio="none">
                <g fill="var(--color-accent-500)">
                  <% bands.forEach(function (band) { %>
                    <rect x="<%= band.x %>" y="<%= band.female.y %>" width="<%= band.width %>" height="<%= band.female.h %>" rx="3"><title><%= band.label %> female &middot; <%= band.femaleLeads %> leads</title></rect>
                  <% }); %>
                </g>
                <g fill="var(--color-neutral-600)">
                  <% bands.forEach(function (band) { %>
                    <rect x="<%= band.maleX %>" y="<%= band.male.y %>" width="<%= band.width %>" height="<%= band.male.h %>" rx="3"><title><%= band.label %> male &middot; <%= band.maleLeads %> leads</title></rect>
                  <% }); %>
                </g>
              </svg>
              <div style="display:flex; justify-content:space-around; font-size:10px; color:var(--color-neutral-700); margin-top:4px;">
                <% bands.forEach(function (band) { %><span><%= band.label %></span><% }); %>
              </div>
              <%
              /* The note is the empty state when there are no bands, so it must not
                 also print underneath one. */
              %>
              <div style="font-size:11px; color:var(--color-neutral-500); margin-top:8px; border-top:1px solid var(--color-neutral-900); padding-top:8px;">
                <%= typeof audAgeNote !== 'undefined' ? audAgeNote : '' %>
              </div>
              <% } %>
            </div>
            <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
              <div style="font-size:13px; font-weight:500; margin-bottom:8px;">Top locations</div>
              <% (audGeo || []).forEach(function (g) { %>
                <div style="display:flex; align-items:center; gap:9px; padding:5.5px 0; font-size:11.5px;">
                  <span style="width:88px; color:var(--color-neutral-400); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= g.name %></span>
                  <div style="flex:1; height:6px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= g.w %>; border-radius:99px; background:var(--color-accent-600);"></div></div>
                  <span style="width:44px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-300);"><%= g.rev %></span>
                </div>
              <% }); %>
            </div>
          </div>
          <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
            <div style="display:flex; align-items:center; margin-bottom:8px;"><div style="font-size:13px; font-weight:500;">Audience segments</div><span style="font-size:10.5px; color:var(--color-neutral-600); margin-left:8px;">interest · lookalike · retargeting · custom</span></div>
            <table style="width:100%; border-collapse:collapse; font-size:12px;">
              <thead><tr style="color:var(--color-neutral-600); font-size:10.5px; text-align:left;"><th style="padding:7px 8px 7px 0; font-weight:500;">SEGMENT</th><th style="padding:7px 8px; font-weight:500;">TYPE</th><th style="padding:7px 8px; font-weight:500;">SATURATION</th><th style="padding:7px 8px; text-align:right; font-weight:500;">SPEND</th><th style="padding:7px 8px; text-align:right; font-weight:500;">LEADS</th><th style="padding:7px 8px; text-align:right; font-weight:500;">BOOKINGS</th><th style="padding:7px 8px; text-align:right; font-weight:500;">AVG BOOKING</th><th style="padding:7px 8px; text-align:right; font-weight:500;">REVENUE</th><th style="padding:7px 8px; text-align:right; font-weight:500;">NET ROAS</th><th style="padding:7px 0 7px 8px; font-weight:500;">AI SUGGESTION</th></tr></thead>
              <tbody>
                <% (audSegs || []).forEach(function (sg) { %>
                  <tr class="hv-1" style="border-top:1px solid var(--color-neutral-900); cursor:pointer;">
                    <td style="padding:8.5px 8px 8.5px 0; color:var(--color-neutral-200); font-weight:500; white-space:nowrap;"><%= sg.name %></td>
                    <td style="padding:8.5px 8px;"><span style="font-size:10px; border:1px solid var(--color-neutral-800); border-radius:5px; padding:1.5px 7px; color:var(--color-neutral-400);"><%= sg.type %></span></td>
                    <td style="padding:8.5px 8px; min-width:100px;"><div style="display:flex; align-items:center; gap:7px;"><div style="flex:1; height:5px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= sg.sat %>; border-radius:99px; background:<%= sg.satColor %>;"></div></div><span style="font-size:10.5px; color:var(--color-neutral-500);"><%= sg.sat %></span></div></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= sg.spend %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= sg.leads %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-200);"><%= sg.bookings %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-400);"><%= sg.abv %></td>
                    <td style="padding:8.5px 8px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-200); font-weight:500;"><%= sg.rev %></td>
                    <td style="padding:8.5px 8px; text-align:right;"><span style="font-weight:500; font-variant-numeric:tabular-nums; color:<%= sg.roasColor %>;"><%= sg.roas %></span></td>
                    <td style="padding:8.5px 0 8.5px 8px;"><span style="font-size:10.5px; color:var(--color-accent-300);"><%= sg.tip %></span></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
