                    </g>
                    <rect x="556" y="30" width="30" height="138" rx="4" fill="var(--color-accent-400)"></rect>
                  </svg>
                  <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:12px; padding-top:12px; border-top:1px solid var(--color-neutral-900);">
