                      <div><div style="font-size:10px; color:var(--color-neutral-600); letter-spacing:.06em;"><%= st.label %></div><div style="font-size:15px; font-weight:500; margin-top:3px; font-variant-numeric:tabular-nums;"><%= st.value %></div></div>
                    <% }); %>
                  </div>
                </div>
              <% } %>

              <% if (dRes) { %>
