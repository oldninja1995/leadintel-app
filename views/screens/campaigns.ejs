                        <div style="flex:1; height:6px; border-radius:99px; background:var(--color-neutral-900);"><div style="height:100%; width:<%= r.w %>; border-radius:99px; background:var(--color-accent-2-600);"></div></div>
                        <span style="width:48px; text-align:right; font-variant-numeric:tabular-nums; color:var(--color-neutral-300);"><%= r.rev %></span>
                      </div>
                    <% }); %>
                  </div>
                </div>
              <% } %>

              <% if (dRevenue) { %>
