<div style="animation:li-fade .25s ease;" data-screen-label="Reports">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
            <h1 style="margin:0; font-family:var(--font-heading); font-weight:500; font-size:19px;">Reports & Dashboards</h1>
            <div style="flex:1;"></div>
            <div class="hv-3" style="display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--color-neutral-500); border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; cursor:pointer;"><i class="ph ph-bookmark-simple" style="font-size:13px;"></i>Bookmarks</div>
            <div class="hv-7" style="display:flex; align-items:center; gap:6px; font-size:11.5px; color:var(--color-accent-300); border:1px solid var(--color-accent-600); border-radius:7px; padding:5px 11px; cursor:pointer;"><i class="ph ph-plus" style="font-size:13px;"></i>New dashboard</div>
          </div>
          <div style="display:flex; gap:4px; margin-bottom:12px; border-bottom:1px solid var(--color-neutral-900); overflow-x:auto;">
            <% (repTabs || []).forEach(function (t) { %>
              <div class="hv-5" data-action="<%= t.go %>" style="padding:8px 13px; font-size:12.5px; cursor:pointer; white-space:nowrap; color:<%= t.color %>; border-bottom:2px solid <%= t.border %>; margin-bottom:-1px;"><%= t.label %></div>
            <% }); %>
          </div>

          <!-- DASHBOARD BUILDER -->
          <% if (repBuilder) { %>
            <div style="display:grid; grid-template-columns:214px 1fr; gap:12px; align-items:start;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:14px; position:sticky; top:0;">
                <div style="font-size:12px; font-weight:500; margin-bottom:2px;">Widget library</div>
                <div style="font-size:10px; color:var(--color-neutral-600); margin-bottom:10px;">drag onto the canvas</div>
                <div style="display:flex; align-items:center; gap:7px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 9px; color:var(--color-neutral-600); margin-bottom:10px;"><i class="ph ph-magnifying-glass" style="font-size:11px;"></i><span style="font-size:11px;">Search widgets…</span></div>
                <% (widgetGroups || []).forEach(function (g) { %>
                  <div style="margin-bottom:10px;">
                    <div style="font-size:9px; letter-spacing:.07em; color:var(--color-neutral-700); margin-bottom:5px;"><%= g.label %></div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:5px;">
                      <% (g.items || []).forEach(function (w) { %>
                        <div class="hv-11" title="<%= w.name %>" style="display:flex; flex-direction:column; align-items:center; gap:4px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:8px 4px; cursor:grab;">
                          <i class="<%= w.icon %>" style="font-size:15px; color:var(--color-accent-400);"></i>
                          <span style="font-size:9px; color:var(--color-neutral-400); text-align:center; line-height:1.2;"><%= w.name %></span>
                        </div>
                      <% }); %>
                    </div>
                  </div>
                <% }); %>
              </div>
              <div>
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                  <div style="display:flex; gap:3px;">
                    <% (dashTabs || []).forEach(function (d) { %>
                      <span class="hv-5" style="font-size:11.5px; padding:5px 12px; border-radius:7px; cursor:pointer; color:<%= d.color %>; background:<%= d.bg %>;"><%= d.label %></span>
                    <% }); %>
                    <span class="hv-2" style="font-size:11.5px; padding:5px 9px; border-radius:7px; cursor:pointer; color:var(--color-neutral-600);"><i class="ph ph-plus"></i></span>
                  </div>
                  <div style="flex:1;"></div>
                  <span style="display:flex; align-items:center; gap:5px; font-size:11px; border:1px solid var(--color-accent-700); background:var(--color-accent-900); border-radius:7px; padding:5px 11px; color:var(--color-accent-300); cursor:pointer;"><i class="ph ph-squares-four" style="font-size:12px;"></i>Editing layout</span>
                  <span class="hv-5" style="font-size:11px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; color:var(--color-neutral-400); cursor:pointer;">Clone</span>
                  <span class="hv-5" style="font-size:11px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; color:var(--color-neutral-400); cursor:pointer;">Share</span>
                  <span class="hv-5" data-action="goPresent" style="display:flex; align-items:center; gap:5px; font-size:11px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; color:var(--color-neutral-400); cursor:pointer;"><i class="ph ph-projector-screen" style="font-size:12px;"></i>Present</span>
                </div>
                <div style="background:repeating-linear-gradient(0deg, transparent, transparent 23px, var(--color-neutral-900) 23px, var(--color-neutral-900) 24px), repeating-linear-gradient(90deg, transparent, transparent 23px, var(--color-neutral-900) 23px, var(--color-neutral-900) 24px); border:1px dashed var(--color-neutral-800); border-radius:12px; padding:12px;">
                  <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:10px;">
                    <% (canvasWidgets || []).forEach(function (w) { %>
                      <div class="hv-12" style="grid-column:span <%= w.span %>; background:var(--color-surface); border-radius:10px; box-shadow:var(--shadow-sm); padding:12px 14px; position:relative; cursor:move; border:1px solid transparent;">
                        <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
                          <span style="font-size:10.5px; color:var(--color-neutral-400); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= w.title %></span>
                          <div style="flex:1;"></div>
                          <i class="ph ph-copy hv-2" style="font-size:11px; color:var(--color-neutral-700); cursor:pointer;"></i>
                          <i class="ph ph-trash hv-13" style="font-size:11px; color:var(--color-neutral-700); cursor:pointer;"></i>
                          <i class="ph ph-dots-six-vertical" style="font-size:12px; color:var(--color-accent-400);"></i>
                        </div>
                        <% if (w.isKpi) { %>
                          <div style="display:flex; align-items:baseline; gap:7px;"><span style="font-size:22px; font-weight:500; font-variant-numeric:tabular-nums;"><%= w.value %></span><span style="font-size:11px; color:<%= w.deltaColor %>;"><%= w.delta %></span></div>
                        <% } %>
                        <% if (w.isLine) { %>
                          <svg viewBox="0 0 300 80" style="width:100%; height:<%= w.h %>;" preserveAspectRatio="none">
                            <path d="M0,64 L40,58 L80,62 L120,46 L160,52 L200,34 L240,40 L300,18 L300,80 L0,80 Z" fill="var(--color-accent-500)" opacity="0.14"></path>
                            <polyline points="0,64 40,58 80,62 120,46 160,52 200,34 240,40 300,18" fill="none" stroke="var(--color-accent-400)" stroke-width="2"></polyline>
                          </svg>
                        <% } %>
                        <% if (w.isBar) { %>
                          <svg viewBox="0 0 300 80" style="width:100%; height:<%= w.h %>;" preserveAspectRatio="none">
                            <g fill="var(--color-accent-600)"><rect x="8" y="42" width="26" height="38" rx="3"></rect><rect x="48" y="30" width="26" height="50" rx="3"></rect><rect x="88" y="38" width="26" height="42" rx="3"></rect><rect x="128" y="22" width="26" height="58" rx="3"></rect><rect x="168" y="28" width="26" height="52" rx="3"></rect><rect x="208" y="14" width="26" height="66" rx="3"></rect></g>
                            <rect x="248" y="8" width="26" height="72" rx="3" fill="var(--color-accent-400)"></rect>
                          </svg>
                        <% } %>
                        <% if (w.isDonut) { %>
                          <div style="display:grid; place-items:center; padding:4px 0;">
                            <svg viewBox="0 0 90 90" style="width:78px; height:78px;">
                              <circle cx="45" cy="45" r="34" fill="none" stroke="var(--color-neutral-900)" stroke-width="11"></circle>
                              <circle cx="45" cy="45" r="34" fill="none" stroke="var(--color-accent-400)" stroke-width="11" stroke-dasharray="81 213.6" transform="rotate(-90 45 45)"></circle>
                              <circle cx="45" cy="45" r="34" fill="none" stroke="var(--color-accent-600)" stroke-width="11" stroke-dasharray="58 213.6" stroke-dashoffset="-81" transform="rotate(-90 45 45)"></circle>
                              <circle cx="45" cy="45" r="34" fill="none" stroke="var(--color-accent-800)" stroke-width="11" stroke-dasharray="41 213.6" stroke-dashoffset="-139" transform="rotate(-90 45 45)"></circle>
                            </svg>
                          </div>
                        <% } %>
                        <% if (w.isFunnel) { %>
                          <div style="display:flex; flex-direction:column; gap:5px; padding-top:2px;">
                            <% (w.bars || []).forEach(function (b) { %>
                              <div style="height:9px; width:<%= b %>; border-radius:99px; background:linear-gradient(90deg, var(--color-accent-700), var(--color-accent-400));"></div>
                            <% }); %>
                          </div>
                        <% } %>
                        <% if (w.isTable) { %>
                          <% (w.rows || []).forEach(function (r) { %>
                            <div style="display:flex; gap:8px; padding:5px 0; border-top:1px solid var(--color-neutral-900); font-size:11px;"><span style="flex:1; color:var(--color-neutral-400); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= r.a %></span><span style="color:var(--color-neutral-200); font-variant-numeric:tabular-nums;"><%= r.b %></span></div>
                          <% }); %>
                        <% } %>
                        <% if (w.isAi) { %>
                          <div style="font-size:11px; color:var(--color-neutral-400); line-height:1.55;"><i class="ph-fill ph-sparkle" style="color:var(--color-accent-400); font-size:11px;"></i> <%= w.text %></div>
                        <% } %>
                      </div>
                    <% }); %>
                    <div class="hv-10" style="grid-column:span 4; border:1px dashed var(--color-neutral-800); border-radius:10px; padding:16px; text-align:center; color:var(--color-neutral-600); cursor:pointer;">
                      <i class="ph ph-plus-circle" style="font-size:17px;"></i><div style="font-size:11px; margin-top:4px;">Drop a widget here, or click to browse the library</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <!-- SCORECARD -->
          <% if (repScorecard) { %>
            <div style="max-width:1000px;">
              <div style="background:linear-gradient(160deg, var(--color-section) 0%, var(--color-section-deep) 75%); border-radius:12px 12px 0 0; box-shadow:var(--shadow-sm); padding:20px 22px;">
                <div style="display:flex; align-items:flex-start;">
                  <div style="flex:1;">
                    <div style="font-size:10px; letter-spacing:.09em; color:var(--color-accent-2-300);">EXECUTIVE SCORECARD · JULY 2026</div>
                    <div style="font-size:22px; font-weight:500; font-family:var(--font-heading); margin-top:5px;">Parakkat Hospitality</div>
                    <div style="font-size:11.5px; color:var(--color-accent-2-300); margin-top:3px;">3 properties · 104 keys · prepared for the owner & board</div>
                  </div>
                  <div style="display:flex; gap:6px;">
                    <span style="font-size:11px; border:1px solid var(--color-section-ghost); border-radius:7px; padding:5px 12px; color:var(--color-accent-2-300); cursor:pointer;">PDF</span>
                    <span style="font-size:11px; border:1px solid var(--color-section-ghost); border-radius:7px; padding:5px 12px; color:var(--color-accent-2-300); cursor:pointer;">PPT</span>
                    <span class="hv-7" style="font-size:11px; border:1px solid var(--color-accent-500); border-radius:7px; padding:5px 12px; color:var(--color-accent-200); cursor:pointer;">Send</span>
                  </div>
                </div>
                <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-top:18px;">
                  <% (scorecardKpis || []).forEach(function (k) { %>
                    <div style="border:1px solid var(--color-section-ghost); border-radius:9px; padding:10px 12px;">
                      <div style="font-size:9px; letter-spacing:.06em; color:var(--color-accent-2-300); opacity:.85; white-space:nowrap;"><%= k.label %></div>
                      <div style="display:flex; align-items:baseline; gap:6px; margin-top:3px;"><span style="font-size:17px; font-weight:500; font-variant-numeric:tabular-nums;"><%= k.value %></span><span style="font-size:10px; color:<%= k.deltaColor %>;"><%= k.delta %></span></div>
                    </div>
                  <% }); %>
                </div>
              </div>
              <div style="background:var(--color-surface); border-radius:0 0 12px 12px; box-shadow:var(--shadow-sm); padding:20px 22px;">
                <div style="border:1px solid var(--color-accent-800); background:var(--color-accent-900); border-radius:10px; padding:14px 16px;">
                  <div style="display:flex; align-items:center; gap:7px; font-size:11.5px; font-weight:500; color:var(--color-accent-200);"><i class="ph-fill ph-sparkle" style="font-size:13px;"></i>AI executive summary</div>
                  <%# A whole executive summary written into this template: "July
                      delivered ₹52.3L in CRM-verified revenue on ₹8.4L of media — Net
                      ROAS 4.8x ... occupancy at 78% ... profit margin holding at 41%",
                      naming a campaign and a response-time improvement, closing with two
                      decisions. Every figure invented, and this is the page people
                      export as a PDF and hand to a board. It is the AI screen's derived
                      paragraph now — the same one, over the same rows. %>
                  <div style="font-size:12.5px; color:var(--color-accent-100); line-height:1.65; margin-top:8px;"><%= (selReport && selReport.summary) || '—' %></div>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:16px;">
                  <div>
                    <div style="font-size:12px; font-weight:500; color:<%= up %>; margin-bottom:6px;">Top opportunities</div>
                    <% (scoreOpps || []).forEach(function (o) { %>
                      <div style="display:flex; gap:9px; padding:8px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px; color:var(--color-neutral-300); line-height:1.5;"><i class="ph ph-arrow-up-right" style="color:<%= up %>; font-size:13px; margin-top:1px;"></i><span style="flex:1;"><%= o.text %></span><span style="color:var(--color-neutral-500); white-space:nowrap;"><%= o.value %></span></div>
                    <% }); %>
                  </div>
                  <div>
                    <div style="font-size:12px; font-weight:500; color:<%= down %>; margin-bottom:6px;">Top risks</div>
                    <% (scoreRisks || []).forEach(function (o) { %>
                      <div style="display:flex; gap:9px; padding:8px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px; color:var(--color-neutral-300); line-height:1.5;"><i class="ph ph-arrow-down-right" style="color:<%= down %>; font-size:13px; margin-top:1px;"></i><span style="flex:1;"><%= o.text %></span><span style="color:var(--color-neutral-500); white-space:nowrap;"><%= o.value %></span></div>
                    <% }); %>
                  </div>
                </div>
                <div style="display:flex; gap:20px; margin-top:16px; padding-top:14px; border-top:1px solid var(--color-neutral-900); font-size:11px; color:var(--color-neutral-600);">
                  <%# Was "Forecast August ₹61.0L (87% confidence)" — the third place in
                      the app carrying that same invented projection, and a confidence
                      figure for a model that does not exist. %>
                  <span>Forecast <b style="color:var(--color-neutral-500); font-weight:500;">—</b> no forecasting model</span>
                  <span>Business health <b style="color:var(--color-neutral-300); font-weight:500;">84 / 100</b></span>
                  <span>Generated 30 Jul 2026 · data verified against CRM & PMS</span>
                </div>
              </div>
            </div>
          <% } %>

          <!-- PRESENTATION MODE -->
          <% if (repPresent) { %>
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
              <span style="font-size:11.5px; color:var(--color-neutral-500);">Slide 2 of 6 · auto-rotate every 30s</span>
              <div style="flex:1;"></div>
              <span class="hv-5" style="display:flex; align-items:center; gap:5px; font-size:11px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; color:var(--color-neutral-400); cursor:pointer;"><i class="ph ph-television-simple" style="font-size:12px;"></i>TV mode</span>
              <span class="hv-5" style="display:flex; align-items:center; gap:5px; font-size:11px; border:1px solid var(--color-neutral-800); border-radius:7px; padding:5px 11px; color:var(--color-neutral-400); cursor:pointer;"><i class="ph ph-moon" style="font-size:12px;"></i>Dark room</span>
              <span class="hv-7" style="display:flex; align-items:center; gap:5px; font-size:11px; border:1px solid var(--color-accent-600); border-radius:7px; padding:5px 11px; color:var(--color-accent-300); cursor:pointer;"><i class="ph ph-corners-out" style="font-size:12px;"></i>Fullscreen</span>
            </div>
            <div style="background:var(--color-canvas); border-radius:14px; box-shadow:var(--shadow-lg); padding:34px 38px; aspect-ratio:16/9; display:flex; flex-direction:column;">
              <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:26px; height:26px; border-radius:7px; border:1px solid var(--color-accent-600); display:grid; place-items:center; color:var(--color-accent-400);"><i class="ph-fill ph-pulse" style="font-size:14px;"></i></div>
                <span style="font-size:12px; color:var(--color-neutral-500); letter-spacing:.06em;">PARAKKAT HOSPITALITY · JULY 2026</span>
                <div style="flex:1;"></div>
                <span style="font-size:12px; color:var(--color-neutral-600);">Revenue performance</span>
              </div>
              <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:26px;">
                <% (presentKpis || []).forEach(function (k) { %>
                  <div>
                    <div style="font-size:12px; letter-spacing:.07em; color:var(--color-neutral-600);"><%= k.label %></div>
                    <div style="font-size:40px; font-weight:500; font-variant-numeric:tabular-nums; margin-top:6px; letter-spacing:-.01em;"><%= k.value %></div>
                    <div style="font-size:14px; color:<%= k.deltaColor %>; margin-top:2px;"><%= k.delta %></div>
                  </div>
                <% }); %>
              </div>
              <div style="flex:1; margin-top:22px; display:flex; align-items:flex-end;">
                <svg viewBox="0 0 900 220" style="width:100%; height:100%;" preserveAspectRatio="none">
                  <g stroke="var(--color-neutral-900)" stroke-width="1"><line x1="0" y1="55" x2="900" y2="55"></line><line x1="0" y1="110" x2="900" y2="110"></line><line x1="0" y1="165" x2="900" y2="165"></line></g>
                  <path d="M0,168 L112,152 L224,158 L336,124 L448,134 L560,96 L672,104 L784,58 L900,40 L900,220 L0,220 Z" fill="var(--color-accent-500)" opacity="0.16"></path>
                  <polyline points="0,168 112,152 224,158 336,124 448,134 560,96 672,104 784,58 900,40" fill="none" stroke="var(--color-accent-400)" stroke-width="3.5" stroke-linejoin="round"></polyline>
                  <circle cx="900" cy="40" r="6" fill="var(--color-accent-300)"></circle>
                </svg>
              </div>
              <div style="display:flex; justify-content:space-between; font-size:12px; color:var(--color-neutral-700); margin-top:8px;"><span>Jan</span><span>Mar</span><span>May</span><span>Jul</span></div>
            </div>
          <% } %>

          <!-- SCHEDULE & SHARING -->
          <% if (repSchedule) { %>
            <div style="display:grid; grid-template-columns:1.4fr 1fr; gap:12px; align-items:start;">
              <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:6px 16px 12px;">
                <table style="width:100%; border-collapse:collapse; font-size:12px;">
                  <thead><tr style="color:var(--color-neutral-600); font-size:10.5px; text-align:left;"><th style="padding:9px 8px 9px 0; font-weight:500;">REPORT</th><th style="padding:9px 8px; font-weight:500;">FREQUENCY</th><th style="padding:9px 8px; font-weight:500;">DELIVERY</th><th style="padding:9px 8px; font-weight:500;">RECIPIENTS</th><th style="padding:9px 8px; font-weight:500;">NEXT RUN</th><th style="padding:9px 0 9px 8px; text-align:right; font-weight:500;">STATUS</th></tr></thead>
                  <tbody>
                    <% (schedules || []).forEach(function (sc) { %>
                      <tr class="hv-1" style="border-top:1px solid var(--color-neutral-900); cursor:pointer;">
                        <td style="padding:9px 8px 9px 0;"><span style="display:flex; align-items:center; gap:8px;"><i class="<%= sc.icon %>" style="font-size:14px; color:var(--color-accent-400);"></i><span style="color:var(--color-neutral-200); white-space:nowrap;"><%= sc.name %></span></span></td>
                        <td style="padding:9px 8px; color:var(--color-neutral-400); white-space:nowrap;"><%= sc.freq %></td>
                        <td style="padding:9px 8px;"><span style="display:flex; gap:6px;"><% (sc.channels || []).forEach(function (ch) { %><i class="<%= ch %>" style="font-size:13px; color:var(--color-neutral-500);"></i><% }); %></span></td>
                        <td style="padding:9px 8px; color:var(--color-neutral-500); white-space:nowrap;"><%= sc.to %></td>
                        <td style="padding:9px 8px; color:var(--color-neutral-400); white-space:nowrap; font-variant-numeric:tabular-nums;"><%= sc.next %></td>
                        <td style="padding:9px 0 9px 8px; text-align:right;"><span style="font-size:10px; border:1px solid var(--color-neutral-800); border-radius:99px; padding:2px 9px; color:<%= sc.statusColor %>;"><%= sc.status %></span></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <div style="display:flex; flex-direction:column; gap:12px;">
                <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
                  <div style="font-size:13px; font-weight:500; margin-bottom:11px;">Share this report</div>
                  <% (shareRows || []).forEach(function (sh) { %>
                    <div style="display:flex; align-items:center; gap:10px; padding:8px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px;">
                      <div style="width:24px; height:24px; border-radius:99px; background:var(--color-neutral-800); display:grid; place-items:center; font-size:8.5px; font-weight:600; color:var(--color-neutral-300); flex:none;"><%= sh.init %></div>
                      <div style="flex:1; min-width:0;"><div style="color:var(--color-neutral-300); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= sh.who %></div><div style="font-size:10px; color:var(--color-neutral-600);"><%= sh.meta %></div></div>
                      <span style="font-size:10px; color:var(--color-neutral-500); white-space:nowrap;"><%= sh.access %></span>
                    </div>
                  <% }); %>
                  <div style="margin-top:12px; padding:11px 12px; border:1px solid var(--color-neutral-800); border-radius:9px;">
                    <div style="display:flex; align-items:center; gap:8px;"><i class="ph ph-link" style="font-size:13px; color:var(--color-accent-400);"></i><span style="flex:1; font-size:11px; color:var(--color-neutral-400); font-family:ui-monospace,monospace; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">analytics.parakkat.in/r/jul26-exec</span><i class="ph ph-copy" style="font-size:13px; color:var(--color-neutral-600); cursor:pointer;"></i></div>
                    <div style="display:flex; gap:12px; margin-top:9px; font-size:10.5px; color:var(--color-neutral-600);"><span><i class="ph ph-lock-key" style="font-size:11px; color:<%= up %>;"></i> Password protected</span><span><i class="ph ph-clock" style="font-size:11px;"></i> Expires Aug 30</span></div>
                  </div>
                </div>
                <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:16px;">
                  <div style="font-size:13px; font-weight:500; margin-bottom:2px;">Export designer</div>
                  <div style="font-size:10.5px; color:var(--color-neutral-600); margin-bottom:11px;">branded output · applies white-label settings</div>
                  <% (exportOpts || []).forEach(function (e) { %>
                    <div class="hv-1" style="display:flex; align-items:center; gap:10px; padding:8px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px; cursor:pointer;">
                      <i class="<%= e.icon %>" style="font-size:15px; color:<%= e.color %>;"></i>
                      <div style="flex:1;"><div style="color:var(--color-neutral-300);"><%= e.name %></div><div style="font-size:10px; color:var(--color-neutral-600);"><%= e.meta %></div></div>
                      <i class="ph ph-caret-right" style="font-size:12px; color:var(--color-neutral-700);"></i>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          <% } %>

          <!-- TEMPLATES (existing library) -->
          <% if (repTemplates) { %>
        <div style="display:grid; grid-template-columns:250px 1fr; gap:12px; height:100%;">
          <div style="display:flex; flex-direction:column; gap:6px;">
            <div style="font-size:10.5px; letter-spacing:.08em; color:var(--color-neutral-600); padding:2px 4px 6px;">REPORT TEMPLATES</div>
            <% (reportList || []).forEach(function (r) { %>
              <div class="hv-1" data-action="<%= r.go %>" style="display:flex; align-items:center; gap:9px; padding:9px 11px; border-radius:9px; cursor:pointer; background:<%= r.bg %>; border:1px solid <%= r.border %>;">
                <i class="<%= r.icon %>" style="font-size:15px; color:<%= r.iconColor %>;"></i>
                <div style="flex:1;"><div style="font-size:12px; color:var(--color-neutral-200);"><%= r.name %></div><div style="font-size:10px; color:var(--color-neutral-600);"><%= r.freq %></div></div>
              </div>
            <% }); %>
          </div>
          <div style="background:var(--color-surface); border-radius:12px; box-shadow:var(--shadow-sm); padding:20px 22px; overflow-y:auto;">
            <div style="display:flex; align-items:center; gap:10px;">
              <div><div style="font-size:16px; font-weight:500; font-family:var(--font-heading);"><%= selReport.name %></div><div style="font-size:11px; color:var(--color-neutral-600); margin-top:2px;"><%= selReport.period %> · auto-scheduled · 4 recipients</div></div>
              <div style="flex:1;"></div>
              <div style="display:flex; gap:6px;">
                <span class="hv-5" style="font-size:11px; border:1px solid var(--color-neutral-800); border-radius:6px; padding:4px 10px; color:var(--color-neutral-400); cursor:pointer;">PDF</span>
                <span class="hv-5" style="font-size:11px; border:1px solid var(--color-neutral-800); border-radius:6px; padding:4px 10px; color:var(--color-neutral-400); cursor:pointer;">Excel</span>
                <span class="hv-5" style="font-size:11px; border:1px solid var(--color-neutral-800); border-radius:6px; padding:4px 10px; color:var(--color-neutral-400); cursor:pointer;">PPT</span>
                <span class="hv-7" style="font-size:11px; border:1px solid var(--color-accent-600); border-radius:6px; padding:4px 10px; color:var(--color-accent-300); cursor:pointer;"><i class="ph ph-envelope-simple" style="font-size:11px;"></i> Email now</span>
              </div>
            </div>
            <div style="margin-top:16px; border:1px solid var(--color-accent-800); background:var(--color-accent-900); border-radius:10px; padding:13px 15px;">
              <div style="display:flex; align-items:center; gap:6px; font-size:11.5px; font-weight:500; color:var(--color-accent-200);"><i class="ph-fill ph-sparkle" style="font-size:13px;"></i>AI executive summary</div>
              <div style="font-size:12px; color:var(--color-accent-100); line-height:1.6; margin-top:7px;"><%= selReport.summary %></div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:14px;">
              <div>
                <div style="font-size:12px; font-weight:500; margin-bottom:6px; color:<%= up %>;">Top performers</div>
                <% (selReport.top || []).forEach(function (t) { %>
                  <div style="display:flex; justify-content:space-between; gap:8px; padding:7px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px;"><span style="color:var(--color-neutral-300);"><%= t.name %></span><span style="font-variant-numeric:tabular-nums; color:var(--color-neutral-200); font-weight:500; white-space:nowrap;"><%= t.val %></span></div>
                <% }); %>
              </div>
              <div>
                <div style="font-size:12px; font-weight:500; margin-bottom:6px; color:<%= down %>;">Needs attention</div>
                <% (selReport.worst || []).forEach(function (t) { %>
                  <div style="display:flex; justify-content:space-between; gap:8px; padding:7px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px;"><span style="color:var(--color-neutral-300);"><%= t.name %></span><span style="font-variant-numeric:tabular-nums; color:var(--color-neutral-200); font-weight:500; white-space:nowrap;"><%= t.val %></span></div>
                <% }); %>
              </div>
            </div>
            <div style="margin-top:14px;">
              <div style="font-size:12px; font-weight:500; margin-bottom:6px;">Recommendations & action items</div>
              <% (selReport.recs || []).forEach(function (rc) { %>
                <div style="display:flex; gap:9px; padding:7px 0; border-top:1px solid var(--color-neutral-900); font-size:11.5px; color:var(--color-neutral-300); line-height:1.5;"><i class="ph ph-arrow-bend-down-right" style="color:var(--color-accent-400); font-size:13px; margin-top:1px;"></i><%= rc %></div>
              <% }); %>
            </div>
            <div style="display:flex; align-items:center; gap:14px; margin-top:16px; padding-top:12px; border-top:1px solid var(--color-neutral-900); font-size:10.5px; color:var(--color-neutral-600);">
              <span class="hv-2" style="display:flex; align-items:center; gap:5px; cursor:pointer;"><i class="ph ph-funnel-simple" style="font-size:12px;"></i>Interactive filters</span>
              <span class="hv-2" style="display:flex; align-items:center; gap:5px; cursor:pointer;"><i class="ph ph-arrows-left-right" style="font-size:12px;"></i>Compare periods</span>
              <span class="hv-2" style="display:flex; align-items:center; gap:5px; cursor:pointer;"><i class="ph ph-printer" style="font-size:12px;"></i>Print</span>
              <span class="hv-2" style="display:flex; align-items:center; gap:5px; cursor:pointer;"><i class="ph ph-chat-circle" style="font-size:12px;"></i>3 comments</span>
              <span class="hv-2" style="display:flex; align-items:center; gap:5px; cursor:pointer;"><i class="ph ph-clock-counter-clockwise" style="font-size:12px;"></i>Version history (v7)</span>
            </div>
          </div>
        </div>
          <% } %>
        </div>
