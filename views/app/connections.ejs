<%
/* Connections — where a credential goes.
 *
 * Not from the design: `LeadIntel App.dc.html` draws no integrations screen, so
 * until this existed there was nowhere to put a token and every connector read
 * synthetic fixtures. Built from the Nocturne tokens.
 *
 * Cards collapse. Five sources with five open forms is a long scroll where
 * nothing stands out, and the common case is touching one source and reading
 * the status of the other four. `<details>` does it natively — no script, and
 * it is keyboard-operable and screen-reader-announced without any help.
 *
 * No stored secret is rendered back, not even masked: a mask still leaks
 * length. Each field says only whether it is set. See lib/connections.js. */

/* Counted by what is arriving, not by what is stored. The tally used to read
   "connected" off stored credentials, so a source that had failed every sync
   for a day still counted towards it. */
const receiving = connections.filter(function (c) { return c.state === 'on'; });
const broken = connections.filter(function (c) { return c.configured && !c.readable; });
const failing = connections.filter(function (c) { return c.state === 'failing'; });

/* Exactly one card starts open, and only when there is something to do:
   whichever source most needs attention. Opening every unconnected one is the
   wall of five forms this screen collapses to avoid — and on a fresh install
   that is all of them, which is precisely when it is worst. */
const needsAttention = broken[0] || failing[0]
  || connections.find(function (c) { return !c.configured; });

/* Seconds, as somebody reading a status line would say it. */
function lag(seconds) {
  if (seconds < 90) return seconds + 's';
  if (seconds < 5400) return Math.round(seconds / 60) + ' min';
  if (seconds < 172800) return Math.round(seconds / 3600) + 'h';
  return Math.round(seconds / 86400) + 'd';
}

/* A refused paste opens the card it was refused on, whatever else needs
   attention — a message about a field the reader cannot see is a message they
   have to go looking for. */
const openSource = canManage
  ? (errorSource || (needsAttention ? needsAttention.source : null))
  : null;
%>
<div class="li-conn">

  <header class="li-conn-head">
    <div class="li-conn-title">
      <h1>Connections</h1>
      <p>
        Credentials for <strong><%= workspaceName %></strong>. Encrypted at rest and never shown again once saved.
        A source with no credential reads synthetic fixtures.
      </p>
    </div>
    <div class="li-conn-tally">
      <span class="li-conn-tally-n"><%= receiving.length %><em>/<%= connections.length %></em></span>
      <span class="li-conn-tally-l">receiving</span>
    </div>
    <%# Every card below is a <details> that starts closed, so the per-source
        Sync button cannot be seen without knowing which source to open. This
        one is visible before anything is expanded. %>
    <% if (canManage && receiving.length) { %>
      <form method="post" action="/connections/sync" class="li-conn-syncall">
        <button type="submit" title="Pull every connected source now, most out-of-date first">
          <i class="ph ph-arrows-clockwise"></i>Sync all
        </button>
      </form>
    <% } %>
  </header>

  <% if (!secretSet) { %>
    <p class="li-conn-notice li-conn-notice--warn">
      <i class="ph ph-warning-circle"></i>
      <span><strong>LEADINTEL_SECRET is not set.</strong> Credentials cannot be encrypted, so nothing will be
      stored. Set it in the environment first — without it there is nowhere safe to keep a token.</span>
    </p>
  <% } %>
  <% if (broken.length) { %>
    <p class="li-conn-notice li-conn-notice--warn">
      <i class="ph ph-key"></i>
      <span><strong><%= broken.length %> credential<%= broken.length === 1 ? '' : 's' %> cannot be decrypted.</strong>
      <code>LEADINTEL_SECRET</code> has changed since they were saved. Re-enter them below.</span>
    </p>
  <% } %>
  <%
  /* A source that has been failing since yesterday was visible only as JSON at
     /ingest/status. Said at the top, because the screens downstream carry on
     drawing whatever arrived last and look no different. */
  %>
  <% if (failing.length) { %>
    <p class="li-conn-notice li-conn-notice--warn">
      <i class="ph ph-warning-octagon"></i>
      <span><strong><%= failing.length %> connected source<%= failing.length === 1 ? ' is' : 's are' %> failing to sync.</strong>
      The credential is stored, but the pipeline's attempts are not getting through — the reason is on the card
      below. Every other screen carries on showing the last data that arrived, and looks no different.</span>
    </p>
  <% } %>
  <% if (!canManage) { %>
    <p class="li-conn-notice"><i class="ph ph-lock-simple"></i><span>Only an Owner can add or change a credential. You can see which sources are connected.</span></p>
  <% } %>
  <% if (error) { %>
    <p class="li-conn-notice li-conn-notice--error"><i class="ph ph-warning-circle"></i><span><%= error %></span></p>
  <% } %>
  <% if (saved) { %>
    <p class="li-conn-notice li-conn-notice--ok"><i class="ph ph-check-circle"></i><span><%= saved %></span></p>
  <% } %>

  <div class="li-conn-list">
    <% connections.forEach(function (c) { %>
      <%
      /* Five states, and the rule for them is in lib/connections.js — see
         `stateOf` for why. It used to be decided here from webhook deliveries
         alone, which could only ever be right for the two sources that push. */
      const state = c.state;
      const label = c.label;
      const open = c.source === openSource;
      %>
      <details class="li-conn-card li-conn-card--<%= state %>" <%= open ? 'open' : '' %>>
        <summary>
          <span class="li-conn-icon"><i class="<%= c.icon %>"></i></span>

          <span class="li-conn-id">
            <strong><%= c.name %></strong>
            <span><%= c.feeds %></span>
          </span>

          <span class="li-conn-status li-conn-status--<%= state %>">
            <span class="li-conn-dot"></span><%= label %>
          </span>

          <i class="ph ph-caret-down li-conn-caret"></i>
        </summary>

        <div class="li-conn-body">
          <% if (c.configured) { %>
            <p class="li-conn-meta">
              Set <%= new Date(c.configuredAt).toISOString().slice(0, 10) %><%= c.configuredBy ? ' by ' + c.configuredBy : '' %>.
              <% if (c.lastTest) { %>
                <%
                /* The date was being dropped, which left "Last test succeeded"
                   standing for a result that could be three months old — read
                   as current by anyone deciding whether to trust the source. */
                %>
                Last test <%= new Date(c.lastTest.at).toISOString().slice(0, 10) %>
                <strong class="<%= c.lastTest.ok ? 'li-ok' : 'li-bad' %>"><%= c.lastTest.ok ? 'succeeded' : 'failed' %></strong>
                — <%= c.lastTest.detail || '' %>
              <% } else { %>
                Never tested.
              <% } %>
            </p>
          <% } %>

          <%
          /* The pipeline's own account of this source. A test is a thing
             somebody pressed once; this is every scheduled attempt since, which
             is what decides whether the numbers on the other screens are
             current. Absent for a workspace the sync loop does not serve. */
          %>
          <% if (c.sync && (c.configured || (c.webhook && c.webhook.minted))) { %>
            <div class="li-conn-sync li-conn-sync--<%= state %>">
              <h4>Sync</h4>
              <p>
                <% if (!c.sync.lastSuccessAt) { %>
                  <strong class="li-bad">No sync has ever succeeded.</strong>
                <% } else { %>
                  Last succeeded <%= new Date(c.sync.lastSuccessAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC<%
                    %><% if (c.sync.lagSeconds !== null) { %>, <%= lag(c.sync.lagSeconds) %> ago<% } %>.
                  <%
                  /* The single field that answers "is this figure real" — the
                     README says so, and it was readable only as JSON. It leads
                     rather than follows, because a fixture sync succeeds every
                     time and its record count is fabricated: printing "8
                     records" first and the caveat afterwards is the reassuring
                     half of the sentence arriving first. */
                  %>
                  <% if (c.sync.transport === 'fixture') { %>
                    <strong class="li-bad">Reading synthetic fixtures</strong>, not this vendor —
                    the <%= c.sync.lastPulled %> record<%= c.sync.lastPulled === 1 ? '' : 's' %> it returned are made up.
                  <% } else { %>
                    It carried
                    <strong class="<%= c.sync.lastPulled ? 'li-ok' : 'li-bad' %>"><%= c.sync.lastPulled %></strong>
                    record<%= c.sync.lastPulled === 1 ? '' : 's' %><%
                      %><% if (c.sync.lastPulled && c.sync.lastWritten === 0) { %>, none new since the previous sync<% } %>.
                  <% } %>
                <% } %>
                Polled every <%= Math.round(c.sync.cadence.every / 60) %> min.
              </p>

              <% if (c.sync.lastError) { %>
                <p class="li-conn-sync-err">
                  <%
                  /* "of the last attempts" named no window, so the number was
                     unreadable — the run log reports failures within its recent
                     window, which is what "recent" says without claiming a
                     count it does not have. */
                  %>
                  <strong><%= c.sync.recentFailures %> recent attempt<%= c.sync.recentFailures === 1 ? '' : 's' %> failed.</strong>
                  <%
                  /* Verbatim. These messages are written to name the fix — a
                     summarised version of "TeleCRM has a credential but no
                     connector" is just "TeleCRM is broken", which sends
                     somebody to re-paste a key that was never the problem. */
                  %>
                  <span><%= c.sync.lastError %></span>
                </p>
              <% } %>
            </div>
          <% } %>

          <% if (c.streams) { %>
            <div class="li-conn-hook">
              <h4>Push intake</h4>
              <% if (!c.webhookUrl) { %>
                <p>No public URL is configured, so there is no address to give this source.
                Set <code>LEADINTEL_PUBLIC_URL</code> and this will show the address to paste.</p>
              <% } else { %>
                <p>Point this source's outbound webhook here. It authenticates with the token
                below, not a login — which is what lets a real system reach it.</p>
                <span class="li-conn-url"><%= c.webhookUrl %></span>
              <% } %>

              <p style="margin-top:8px;">
                <% if (c.webhook.minted) { %>
                  Token minted <%= new Date(c.webhook.createdAt).toISOString().slice(0, 10) %><%= c.webhook.createdBy ? ' by ' + c.webhook.createdBy : '' %>.
                  <% if (c.webhook.deliveries) { %>
                    <strong class="<%= c.webhook.records ? 'li-ok' : 'li-bad' %>"><%= c.webhook.deliveries %></strong>
                    deliver<%= c.webhook.deliveries === 1 ? 'y' : 'ies' %> carrying
                    <strong class="<%= c.webhook.records ? 'li-ok' : 'li-bad' %>"><%= c.webhook.records %></strong>
                    record<%= c.webhook.records === 1 ? '' : 's' %>, last
                    <%= new Date(c.webhook.lastDeliveryAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC.
                    <% if (!c.webhook.records) { %>
                      <em>Reaching us, but nothing readable in the payload.</em>
                    <% } %>
                  <% } else { %>
                    <em>Nothing has been delivered to it yet.</em>
                  <% } %>
                <% } else { %>
                  No token yet — this intake refuses every call until one exists.
                <% } %>
              </p>

              <% if (canManage) { %>
                <form method="post" action="/connections/<%= c.source %>/webhook" class="li-conn-actions">
                  <button type="submit" class="li-conn-secondary">
                    <i class="ph ph-key"></i><%= c.webhook.minted ? 'Replace token' : 'Mint token' %>
                  </button>
                  <% if (c.webhook.minted) { %>
                    <button type="submit" formaction="/connections/<%= c.source %>/webhook/remove" class="li-conn-danger">
                      <i class="ph ph-prohibit"></i>Revoke
                    </button>
                  <% } %>
                </form>
              <% } %>

              <% if (mintedToken && mintedToken.source === c.source) { %>
                <div class="li-conn-token">
                  <strong>Copy this now — it is shown once and never again.</strong>
                  <% if (mintedToken.replaced) { %>
                    <br><em>The previous token stopped working the moment this one was made.</em>
                  <% } %>
                  <code><%= mintedToken.token %></code>
                </div>
              <% } %>
            </div>
          <% } %>

          <%
          /* The account picker. Shown only for the source it was fetched for,
             and only when there is something to choose — a ten-digit id typed
             from memory is the one field here with no feedback until a sync
             fails fifteen minutes later. */
          %>
          <% if (canManage && accounts && accounts.source === c.source) { %>
            <div class="li-conn-sync">
              <h4>Accounts this credential can reach</h4>
              <% if (!accounts.list.length) { %>
                <p>None. The credential authenticates but no account is linked to it.</p>
              <% } else { %>
                <form method="post" action="/connections/<%= c.source %>">
                  <% accounts.list.forEach(function (a) { %>
                    <label style="display:flex; align-items:center; gap:9px; padding:6px 0; font-size:12.5px; color:var(--color-neutral-300); cursor:pointer;">
                      <input type="radio" name="customerId" value="<%= a.id %>">
                      <span style="font-family:ui-monospace,monospace;"><%= a.id %></span>
                      <% if (a.name) { %><span style="color:var(--color-neutral-500);"><%= a.name %></span><% } %>
                      <% if (a.manager) { %><span style="font-size:10px; border:1px solid var(--color-neutral-800); border-radius:5px; padding:1px 6px; color:var(--color-neutral-600);">MANAGER</span><% } %>
                      <% if (a.currency) { %><span style="font-size:10px; color:var(--color-neutral-700);"><%= a.currency %></span><% } %>
                    </label>
                  <% }); %>
                  <%
                  /* Names come from a second call per account, and that one is
                     refused by a Test-level developer token while the list
                     itself is allowed. Saying so beats an unexplained column of
                     bare numbers. */
                  %>
                  <% if (!accounts.list.some(function (a) { return a.name; })) { %>
                    <p style="margin-top:6px;">Names could not be read — that call needs a developer token with Basic access. The ids are still correct.</p>
                  <% } %>
                  <div class="li-conn-actions">
                    <button type="submit"><i class="ph ph-check"></i>Use this account</button>
                  </div>
                </form>
              <% } %>
            </div>
          <% } %>

          <% if (canManage) { %>
            <form method="post" action="/connections/<%= c.source %>" class="li-conn-form">
              <div class="li-conn-grid">
                <% c.fields.forEach(function (f) { %>
                  <div class="li-conn-field<%= f.hint && f.hint.length > 48 ? ' li-conn-field--wide' : '' %>">
                    <label for="<%= c.source %>-<%= f.key %>">
                      <span><%= f.label %></span>
                      <% if (f.set) { %><em class="li-conn-set">set</em><% } %>
                      <% if (f.optional) { %><em>optional</em><% } %>
                    </label>
                    <%
                    /* A non-secret field is prefilled with what is stored, so
                       the screen can be compared against the vendor's console
                       — which is the only way to catch a stale OAuth client id
                       or an ad account id pasted from the wrong account. A
                       secret stays blank and "leave blank to keep" still
                       applies to it. */
                    %>
                    <input id="<%= c.source %>-<%= f.key %>" name="<%= f.key %>"
                           type="<%= f.secret ? 'password' : 'text' %>"
                           autocomplete="off" spellcheck="false"
                           <%= !f.secret && f.value ? 'value="' + f.value.replace(/"/g, '&quot;') + '"' : '' %>
                           placeholder="<%= f.set ? 'leave blank to keep' : (f.hint || '') %>">
                    <% if (f.hint && f.set) { %><small><%= f.hint %></small><% } %>
                  </div>
                <% }); %>
              </div>

              <div class="li-conn-actions">
                <button type="submit" <%= secretSet ? '' : 'disabled' %>>
                  <i class="ph <%= c.configured ? 'ph-arrow-clockwise' : 'ph-plugs-connected' %>"></i><%= c.configured ? 'Update' : 'Connect' %>
                </button>
                <% if (c.configured) { %>
                  <button type="submit" formaction="/connections/<%= c.source %>/test" class="li-conn-secondary"><i class="ph ph-pulse"></i>Test</button>
                  <%# Runs this source now, whether or not the scheduler thinks it
                      is due. The card above says when it last succeeded; this is
                      how somebody changes that answer without waiting for a cron
                      tick. %>
                  <button type="submit" formaction="/connections/<%= c.source %>/sync" class="li-conn-secondary" title="Pull this source now, without waiting for the schedule"><i class="ph ph-arrows-clockwise"></i>Sync now</button>
                  <%# A Google refresh token expires — in seven days while the
                      OAuth consent screen is in Testing — and replacing it meant
                      the OAuth playground and a copied string. This does the same
                      exchange in the browser. A link rather than a submit button:
                      it navigates to Google, and posting the credential form on
                      the way would save half-filled fields. %>
                  <% if (c.source === 'google_ads' || c.source === 'google_analytics') { %>
                    <a class="li-conn-secondary li-conn-oauth" href="/connections/<%= c.source %>/oauth/start" title="Sign in with Google and store a fresh refresh token">
                      <i class="ph ph-google-logo"></i>Re-authorise
                    </a>
                  <% } %>
                  <%# A year of history, a week per round trip. The window is
                      too wide for one request — see the backfill route — so the
                      button carries where the last press stopped and continues
                      from there. %>
                  <button type="submit" formaction="/connections/<%= c.source %>/backfill" name="days" value="365" class="li-conn-secondary" title="Fetch a year of history, continuing from where the last press stopped"><i class="ph ph-clock-counter-clockwise"></i>Fetch 365 days</button>
                  <input type="hidden" name="before" value="<%= locals.before || '' %>">
                  <% if (c.source === 'google_ads') { %>
                    <button type="submit" formaction="/connections/<%= c.source %>/accounts" class="li-conn-secondary" title="Ask Google which accounts these credentials can reach"><i class="ph ph-list-magnifying-glass"></i>List accounts</button>
                  <% } %>
                  <button type="submit" formaction="/connections/<%= c.source %>/remove" class="li-conn-danger"><i class="ph ph-plugs"></i>Disconnect</button>
                <% } %>
                <div style="flex:1;"></div>
                <% if (c.docs) { %><a class="li-conn-docs" href="<%= c.docs %>" target="_blank" rel="noreferrer noopener">API docs <i class="ph ph-arrow-square-out"></i></a><% } %>
              </div>
            </form>
          <% } %>
        </div>
      </details>
    <% }); %>
  </div>

  <p class="li-conn-foot">
    <i class="ph ph-info"></i>
    <span>Connecting a source changes it for that source only, and nothing downstream can tell the difference —
    normalisation, identity resolution, attribution and the metric registry read whatever arrives. A stored
    credential and a working connector are separate things: <strong>Test</strong> says which you have.</span>
  </p>
</div>
