<%
/* Google Ads Analytics — Google's own hierarchy, not Meta's.
 *
 * Meta Ads Analytics is campaign → ad set → ad. Google is campaign → ad GROUP →
 * ad, with keywords and the search terms that matched them beneath, and no
 * ad-set concept at all. Two screens, because they are two shapes: rendering
 * Google's rows through Meta's projection is what put ad groups under a column
 * labelled "ad set".
 *
 * Markup is the OTA screen's — `li-ota-panel`, `li-ota-scroll`, `li-ota-table`,
 * `li-num` — rather than classes of its own. The first version of this file
 * invented `li-card` and `li-table`, which exist nowhere, so six unstyled
 * tables rendered in a row. Borrowing a styled vocabulary beats inventing an
 * unstyled one; a screen-specific stylesheet can come later if this ever needs
 * to look different, rather than merely to look right.
 *
 * Every table declines rather than invents. A level with no rows says which
 * source would carry them.
 *
 * Keywords and search terms are NOT here — they are Keyword Analytics, at
 * /google-ads/keywords. Five thousand search-term rows were rendering below the
 * fold on every load of this screen. Both are built from one payload, so the
 * two cannot report different totals for the same range.
 */
const d = data || {};
const num = (v) => (v === null || v === undefined ? '—' : Number(v).toLocaleString('en-IN'));
const txt = (v) => (v === null || v === undefined || v === '' ? '—' : v);
const chip = (v) => String(v || '—').replace(/_/g, ' ').toLowerCase();
%>

<% if (!d.connected) { %>
  <p class="li-conn-notice li-conn-notice--warn">
    <i class="ph ph-warning-diamond"></i>
    <strong>Google Ads is not connected.</strong>
    Store a credential on the Connections screen — nothing below is invented while it is absent.
  </p>
<% } %>

<!-- Reservation value, both books ------------------------------------------>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Reservation value &amp; cumulative ROAS</h2>
    <p>
      Google Ads counts conversions and never prices them. Two systems price them, and each
      sees a different half: <strong>the CRM</strong> holds the bookings a salesperson closed
      from a Google-tagged lead, and <strong>GA4</strong> holds what the booking engine took
      from sessions it classified as Paid&nbsp;Search. Cumulative ROAS is both against the one
      spend that paid for both.
    </p>
  </div>

  <% const ps = d.paidSearch || {}; %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Book</th>
          <th class="li-num">Reservation value</th>
          <th class="li-num">Reservations</th>
          <th class="li-num">ROAS on Google spend</th>
          <th>What it is</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>CRM &mdash; Google-tagged, won</td>
          <td class="li-num"><%= txt(ps.crmRevenueText) %></td>
          <td class="li-num"><%= num(ps.crmBookings) %></td>
          <td class="li-num"><%= txt(ps.crmRoasText) %></td>
          <td>
            <% if (ps.crmAbsent) { %>
              <%= ps.crmAbsent %>
            <% } else { %>
              Deal value a salesperson entered on a lead the CRM tagged Google, cancellations
              excluded. The phone half &mdash; a booking GA4 cannot see.
            <% } %>
          </td>
        </tr>
        <tr>
          <td>GA4 &mdash; Paid Search sessions</td>
          <td class="li-num"><%= txt(ps.revenueText) %></td>
          <td class="li-num"><%= num(ps.bookings) %></td>
          <td class="li-num"><%= txt(ps.roasText) %></td>
          <td>
            <% if (ps.absent) { %>
              <%= ps.absent %>
            <% } else { %>
              Booking-engine revenue over <%= num(ps.days) %> day(s), on Google's own
              <code>sessionDefaultChannelGroup</code> label. The online half.
            <% } %>
          </td>
        </tr>
        <tr>
          <th>Cumulative</th>
          <th class="li-num"><%= txt(ps.cumulativeRevenueText) %></th>
          <th class="li-num">&mdash;</th>
          <th class="li-num"><%= txt(ps.cumulativeRoasText) %></th>
          <th>
            <% if ((ps.books || []).length) { %>
              <%= ps.books.join(' + ') %> &divide; <%= txt(d.campaignTotal && d.campaignTotal.spendText) %>
              of Google Ads spend, same range.
            <% } else { %>
              Neither system reported reservation value in this range.
            <% } %>
          </th>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="li-ota-foot">
    <% if (ps.overlaps) { %>
      <strong>The two books are added, not reconciled.</strong> A guest who booked on the
      website <em>and</em> was entered into the CRM is counted twice here, and nothing can net
      that off until a PMS gives both one folio. It is offered anyway because the opposite
      error is worse and was the one being made: charging Google's whole spend against one
      half of its return understates the account by the size of the other half.
    <% } else if ((ps.books || []).length === 1) { %>
      Only the <strong><%= ps.books[0] %></strong> book reported in this range, so the
      cumulative figure is that book alone &mdash; no double count is possible, and no second
      half is being claimed.
    <% } %>
    The reservation count is left blank on the cumulative row on purpose: CRM deals and
    booking-engine purchases overlap by an unmeasured amount, so a summed count would be a
    number nobody could divide by.
  </p>

  <p class="li-ota-foot">
    GA4's half is <strong>GA4's attribution, not Google Ads'</strong> &mdash; different models
    and windows, and its Paid Search covers any CPC search session, not only this account's.
    The CRM's half is deal value entered at conversion, not money collected.
  </p>
</section>

<!-- Campaigns --------------------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Campaigns</h2>
    <p>Spend and delivery per campaign. Where the account is actually managed is a level down, on <a href="/google-ads/keywords<%= d.qs || '' %>">Keyword Analytics</a>.</p>
  </div>

  <% if (!(d.campaigns || []).length) { %>
    <p class="li-ota-foot">No campaign rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Campaign</th><th>Type</th>
          <th class="li-num">Spend</th><th class="li-num">Impressions</th>
          <th class="li-num">Clicks</th><th class="li-num">CPC</th><th class="li-num">Conv.</th><th class="li-num">Cost/conv.</th>
        </tr>
      </thead>
      <tbody>
        <% d.campaigns.forEach((c) => { %>
          <tr>
            <td><%= txt(c.campaign) %></td>
            <td><span class="li-chip"><%= chip(c.channelType) %></span></td>
            <td class="li-num"><%= txt(c.spendText) %></td>
            <td class="li-num"><%= num(c.impressions) %></td>
            <td class="li-num"><%= num(c.clicks) %></td><td class="li-num"><%= txt(c.cpcText) %></td>
            <td class="li-num"><%= num(c.conversions) %></td><td class="li-num"><%= txt(c.cplText) %></td>
          </tr>
        <% }); %>
      </tbody>
      <%
      /* Summed from the rows above rather than from a second read, so the total
         and the column it sits under cannot disagree. */
      const tot = d.campaignTotal || {};
      %>
      <tfoot>
        <tr>
          <th>All campaigns</th><th></th>
          <th class="li-num"><%= txt(tot.spendText) %></th>
          <th class="li-num"><%= num(tot.impressions) %></th>
          <th class="li-num"><%= num(tot.clicks) %></th>
          <th class="li-num"><%= txt(tot.cpcText) %></th>
          <th class="li-num"><%= num(tot.conversions) %></th>
          <th class="li-num"><%= txt(tot.cplText) %></th>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>
</section>

<!-- Ad groups --------------------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Ad groups</h2>
    <p>Google's grouping level. Not an ad set — a different entity, measured separately, which is why it lives on its own screen.</p>
  </div>

  <% if (!(d.adGroups || []).length) { %>
    <p class="li-ota-foot">No ad group rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr><th>Ad group</th><th class="li-num">Spend</th><th class="li-num">Impressions</th><th class="li-num">Clicks</th><th class="li-num">CPC</th><th class="li-num">Conv.</th><th class="li-num">Cost/conv.</th></tr>
      </thead>
      <tbody>
        <% d.adGroups.forEach((g) => { %>
          <tr>
            <td><%= txt(g.adgroup) %></td>
            <td class="li-num"><%= txt(g.spendText) %></td>
            <td class="li-num"><%= num(g.impressions) %></td>
            <td class="li-num"><%= num(g.clicks) %></td><td class="li-num"><%= txt(g.cpcText) %></td>
            <td class="li-num"><%= num(g.conversions) %></td><td class="li-num"><%= txt(g.cplText) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- Ads --------------------------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Ads</h2>
    <p>A responsive search ad has no name — Google composes it from assets — so its id is shown rather than a label invented for it.</p>
  </div>

  <% if (!(d.ads || []).length) { %>
    <p class="li-ota-foot">No ad rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr><th>Ad</th><th>Type</th><th>Status</th><th class="li-num">Spend</th><th class="li-num">Clicks</th><th class="li-num">CPC</th><th class="li-num">Conv.</th><th class="li-num">Cost/conv.</th></tr>
      </thead>
      <tbody>
        <% d.ads.forEach((a) => { %>
          <tr>
            <td><%= a.ad || ('#' + txt(a.adId)) %></td>
            <td><span class="li-chip"><%= chip(a.adType) %></span></td>
            <td><%= chip(a.status) %></td>
            <td class="li-num"><%= txt(a.spendText) %></td>
            <td class="li-num"><%= num(a.clicks) %></td><td class="li-num"><%= txt(a.cpcText) %></td>
            <td class="li-num"><%= num(a.conversions) %></td><td class="li-num"><%= txt(a.cplText) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- Conversions by action --------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Conversions by action</h2>
    <p>
      Split by the action that produced them. Google's undivided figure sums every action an
      account defines into one fractional number that names none of them — a booking enquiry, a
      phone click and a page view counted alike.
    </p>
  </div>

  <% if (!(d.conversions || []).length) { %>
    <p class="li-ota-foot">No conversion rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Action</th><th>Category</th><th>Counted as</th>
          <th class="li-num">All conversions</th><th class="li-num">Conversions</th>
          <th class="li-num">Value</th>
        </tr>
      </thead>
      <tbody>
        <% d.conversions.forEach((c) => { %>
          <tr>
            <td><%= txt(c.action) %></td>
            <td><%= chip(c.category) %></td>
            <%
            /* Why a row can read 3,400 in one column and 0 in the next. Google
               splits conversion actions into primary — counted in the
               Conversions column and used for bidding — and secondary, which it
               records and deliberately leaves out of both. Five of this
               account's six are secondary, so the single-column table said they
               had never fired. */
            %>
            <td><% if (c.counting) { %><span class="li-chip" title="<%= c.counting %>"><%= c.conversions > 0 ? 'primary' : 'secondary' %></span><% } else { %>—<% } %></td>
            <%
            /* Left fractional on purpose: Google splits conversion credit across
               touches, so rounding 4.166666 to 4 would discard the fraction on
               every row and quietly understate the total. */
            %>
            <td class="li-num" title="Everything this action recorded, primary or not."><%= txt(c.allConversions) %></td>
            <td class="li-num" title="What Google counts toward the Conversions column and bids on. Zero for a secondary action by construction, not because nothing happened."><%= txt(c.conversions) %></td>
            <td class="li-num" title="<%= c.allValueText && c.allValueText !== c.valueText ? 'All-conversions value: ' + c.allValueText : 'Conversion value as Google Ads recorded it. ₹0 means no value is assigned to this action in the account — the booking engine’s revenue is on Website Analytics, from GA4.' %>"><%= txt(c.valueText) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
