<%
/* Google Ads Analytics — Google's own hierarchy, not Meta's.
 *
 * Meta Ads Analytics is campaign → ad set → ad. Google is campaign → ad GROUP →
 * ad, with keywords and the search terms that matched them beneath, and no
 * ad-set concept at all. Two screens, because they are two shapes: rendering
 * Google's rows through Meta's projection is what put ad groups under a column
 * labelled "ad set".
 *
 * Markup is the OTA screen's — `li-ota-panel`, `li-ota-scroll`, `li-ota-table`,
 * `li-num` — rather than classes of its own. The first version of this file
 * invented `li-card` and `li-table`, which exist nowhere, so six unstyled
 * tables rendered in a row. Borrowing a styled vocabulary beats inventing an
 * unstyled one; a screen-specific stylesheet can come later if this ever needs
 * to look different, rather than merely to look right.
 *
 * Every table declines rather than invents. A level with no rows says which
 * source would carry them, and the keyword table distinguishes "no keywords"
 * from "keywords do not apply" — an App or Performance Max campaign having none
 * is a different fact from a Search campaign having none.
 */
const d = data || {};
const num = (v) => (v === null || v === undefined ? '—' : Number(v).toLocaleString('en-IN'));
const txt = (v) => (v === null || v === undefined || v === '' ? '—' : v);
const chip = (v) => String(v || '—').replace(/_/g, ' ').toLowerCase();
%>

<% if (!d.connected) { %>
  <p class="li-conn-notice li-conn-notice--warn">
    <i class="ph ph-warning-diamond"></i>
    <strong>Google Ads is not connected.</strong>
    Store a credential on the Connections screen — nothing below is invented while it is absent.
  </p>
<% } %>

<!-- Campaigns --------------------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Campaigns</h2>
    <p>Spend and delivery per campaign. The keyword detail beneath is where the account is actually managed.</p>
  </div>

  <% if (!(d.campaigns || []).length) { %>
    <p class="li-ota-foot">No campaign rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Campaign</th><th>Type</th>
          <th class="li-num">Spend</th><th class="li-num">Impressions</th>
          <th class="li-num">Clicks</th><th class="li-num">Conv.</th>
        </tr>
      </thead>
      <tbody>
        <% d.campaigns.forEach((c) => { %>
          <tr>
            <td><%= txt(c.campaign) %></td>
            <td><span class="li-chip"><%= chip(c.channelType) %></span></td>
            <td class="li-num"><%= txt(c.spendText) %></td>
            <td class="li-num"><%= num(c.impressions) %></td>
            <td class="li-num"><%= num(c.clicks) %></td>
            <td class="li-num"><%= num(c.conversions) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- Search terms ------------------------------------------------------------>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Search terms</h2>
    <p>
      What people actually typed, as opposed to what was bid on. Keywords say what was bought;
      this says what was sold against — and it is the only place wasted spend and
      negative-keyword opportunities are visible. Placed above keywords for that reason.
    </p>
  </div>

  <% if (!(d.searchTerms || []).length) { %>
    <p class="li-ota-foot">No search term rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Search term</th><th>Status</th>
          <th class="li-num">Spend</th><th class="li-num">Impressions</th>
          <th class="li-num">Clicks</th><th class="li-num">Conv.</th>
        </tr>
      </thead>
      <tbody>
        <% d.searchTerms.forEach((t) => { %>
          <%
          /* Spend with nothing to show for it. Flagged rather than sorted away:
             this table is a worklist, and the rows worth acting on are the ones
             that cost money and converted nobody. */
          const wasted = (t.spend > 0) && !t.conversions;
          %>
          <tr>
            <td><%= txt(t.term) %><% if (wasted) { %> <span class="li-chip">wasted</span><% } %></td>
            <td><%= chip(t.termStatus) %></td>
            <td class="li-num"><%= txt(t.spendText) %></td>
            <td class="li-num"><%= num(t.impressions) %></td>
            <td class="li-num"><%= num(t.clicks) %></td>
            <td class="li-num"><%= num(t.conversions) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- Keywords ---------------------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Keywords</h2>
    <p>Shown verbatim — a keyword is the literal string that was bid on, and match type is what decides how far Google may stray from it.</p>
  </div>

  <% if (d.keywordsNotApplicable) { %>
    <p class="li-ota-foot li-ota-foot--warn">
      Not applicable — <%= d.keywordsNotApplicable %>. Keywords exist only on Search campaigns,
      so an empty table here would claim there were none rather than that the concept does not apply.
    </p>
  <% } else if (!(d.keywords || []).length) { %>
    <p class="li-ota-foot">No keyword rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Keyword</th><th>Match</th><th class="li-num">Quality</th>
          <th class="li-num">Spend</th><th class="li-num">Clicks</th><th class="li-num">Conv.</th>
        </tr>
      </thead>
      <tbody>
        <% d.keywords.forEach((k) => { %>
          <tr>
            <td><%= txt(k.keyword) %></td>
            <td><span class="li-chip"><%= chip(k.matchType) %></span></td>
            <td class="li-num"><%= txt(k.qualityScore) %></td>
            <td class="li-num"><%= txt(k.spendText) %></td>
            <td class="li-num"><%= num(k.clicks) %></td>
            <td class="li-num"><%= num(k.conversions) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- Ad groups --------------------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Ad groups</h2>
    <p>Google's grouping level. Not an ad set — a different entity, measured separately, which is why it lives on its own screen.</p>
  </div>

  <% if (!(d.adGroups || []).length) { %>
    <p class="li-ota-foot">No ad group rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr><th>Ad group</th><th class="li-num">Spend</th><th class="li-num">Impressions</th><th class="li-num">Clicks</th><th class="li-num">Conv.</th></tr>
      </thead>
      <tbody>
        <% d.adGroups.forEach((g) => { %>
          <tr>
            <td><%= txt(g.adgroup) %></td>
            <td class="li-num"><%= txt(g.spendText) %></td>
            <td class="li-num"><%= num(g.impressions) %></td>
            <td class="li-num"><%= num(g.clicks) %></td>
            <td class="li-num"><%= num(g.conversions) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- Ads --------------------------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Ads</h2>
    <p>A responsive search ad has no name — Google composes it from assets — so its id is shown rather than a label invented for it.</p>
  </div>

  <% if (!(d.ads || []).length) { %>
    <p class="li-ota-foot">No ad rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr><th>Ad</th><th>Type</th><th>Status</th><th class="li-num">Spend</th><th class="li-num">Clicks</th><th class="li-num">Conv.</th></tr>
      </thead>
      <tbody>
        <% d.ads.forEach((a) => { %>
          <tr>
            <td><%= a.ad || ('#' + txt(a.adId)) %></td>
            <td><span class="li-chip"><%= chip(a.adType) %></span></td>
            <td><%= chip(a.status) %></td>
            <td class="li-num"><%= txt(a.spendText) %></td>
            <td class="li-num"><%= num(a.clicks) %></td>
            <td class="li-num"><%= num(a.conversions) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<!-- Conversions by action --------------------------------------------------->
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Conversions by action</h2>
    <p>
      Split by the action that produced them. Google's undivided figure sums every action an
      account defines into one fractional number that names none of them — a booking enquiry, a
      phone click and a page view counted alike.
    </p>
  </div>

  <% if (!(d.conversions || []).length) { %>
    <p class="li-ota-foot">No conversion rows in this range.</p>
  <% } else { %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr><th>Action</th><th>Category</th><th class="li-num">Conversions</th><th class="li-num">Value</th></tr>
      </thead>
      <tbody>
        <% d.conversions.forEach((c) => { %>
          <tr>
            <td><%= txt(c.action) %></td>
            <td><%= chip(c.category) %></td>
            <%
            /* Left fractional on purpose: Google splits conversion credit across
               touches, so rounding 4.166666 to 4 would discard the fraction on
               every row and quietly understate the total. */
            %>
            <td class="li-num"><%= txt(c.conversions) %></td>
            <td class="li-num"><%= txt(c.valueText) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
