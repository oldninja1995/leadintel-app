<%
/* The sign-in page — a standalone document, not wrapped in `layout.ejs`: the
   app shell assumes a signed-in user and a workspace, and neither exists yet.
 *
 * Not from the design. `LeadIntel Auth & Onboarding.dc.html` exists in the
 * design project but has never been converted, so this is built from the
 * Nocturne tokens rather than transcribed. It is deliberately plain — inventing
 * a marketing-grade sign-in for a screen the design already specifies would be
 * work thrown away the day that file is imported.
 *
 * The seeded accounts and their shared password are printed on the page. They
 * are fixtures, not secrets, and hiding them would make the app harder to look
 * at without making anything safer. */
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in — LeadIntel AI</title>
<%# Fonts and icons are served from /assets, not from fonts.googleapis.com and
    unpkg.com. Three render-blocking stylesheets across two extra origins used
    to sit ahead of the first paint here, each paying its own DNS, TCP and TLS
    before it started; measured from Kerala they cost ~260ms, ~280ms and ~370ms
    against a server that answers the page in ~100ms. See the notes at the top
    of inter.css and phosphor.css. %>
<%# Declared, so the browser stops probing /favicon.ico — which this app has
    never had. Every page load spent a request on it and logged a 404 in the
    console, and the 404 page it reached is the one the note further down
    explains had to be taught to render without a screen behind it. %>
<link rel="icon" href="<%= asset('favicon.svg') %>" type="image/svg+xml">
<%# Preloaded at the literal path inter.css asks for, with no ?v= on it. The
    fingerprint helper would produce a *different* URL from the one inside the
    stylesheet, and a browser treats those as two fonts: the preload fetched
    47KB and then the stylesheet fetched the same 47KB again. Fonts are busted
    by renaming the file, which is what swapping a typeface means anyway. %>
<link rel="preload" href="/assets/fonts/Inter-latin.f11d729b.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= asset('inter.css') %>">
<link rel="stylesheet" href="<%= asset('phosphor.css') %>">
<%# Fingerprinted like every other reference. Left bare, these three were the
    one door through which a browser could cache an asset under a URL that does
    not change when the file does — which is the whole reason /assets is now
    served immutable for a year. %>
<link rel="stylesheet" href="<%= asset('nocturne.css') %>">
<link rel="stylesheet" href="<%= asset('app.css') %>">
<link rel="stylesheet" href="<%= asset('app-ui.css') %>">
</head>
<body>
<div class="li-login">
  <div class="li-login-card">
    <div class="li-login-brand">
      <div class="li-login-mark"><i class="ph-fill ph-pulse"></i></div>
      <div>
        <strong>LeadIntel AI</strong>
        <span>Hospitality revenue OS</span>
      </div>
    </div>

    <% if (error) { %>
      <p class="li-login-error"><i class="ph ph-warning-circle"></i><%= error %></p>
    <% } %>

    <form method="post" action="/login">
      <input type="hidden" name="next" value="<%= next %>">

      <label for="li-user">Sign in as</label>
      <select id="li-user" name="user" required>
        <% users.forEach(function (u) { %>
          <option value="<%= u.id %>"><%= u.name %> — <%= u.roleName %> · <%= u.workspaceName %></option>
        <% }); %>
      </select>

      <label for="li-password">Password</label>
      <input id="li-password" name="password" type="password" autocomplete="current-password" required
             placeholder="<%= seedPassword %>">

      <button type="submit">Sign in</button>
    </form>

    <p class="li-login-note">
      These are <strong>seeded accounts, not real people</strong> — no registration, no password
      reset, no email. Every one uses the password <code><%= seedPassword %></code>, printed here
      because a fixture credential that looked secret would be the worst of both worlds.
    </p>
    <p class="li-login-note">
      <%= workspaces.length %> workspaces exist so isolation can be demonstrated:
      <% workspaces.forEach(function (w, i) { %><%= w.name %><%= i < workspaces.length - 1 ? ' and ' : '' %><% }); %>.
      Signing into one shows nothing of the other.
    </p>
  </div>
</div>
</body>
</html>
