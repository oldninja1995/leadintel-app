<%
/* Self-serve sign-up — creates a REAL workspace via lib/auth/tenants.js,
   POST /signup. Not a lead-capture form standing in for one: it hashes a
   real password and starts a real session, the same way /login does for a
   seeded fixture. What it does NOT do is touch billing — there is no billing
   engine (see data/admin-accounts.js's header), so the plan chosen here is
   recorded and nothing is charged. Say so on the page rather than implying
   a card will be billed. */
const closed = !cfg.selfServe || !cfg.registration;
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/marketing-head', { title: 'Start free' }) %>
</head>
<body class="li-page">
<div class="li-auth-grid">
  <div class="li-auth-card">
    <div class="li-auth-brand">
      <a href="/home" class="li-brand" style="text-decoration:none;">
        <span class="li-brand-mark"><i class="ph-fill ph-pulse"></i></span>
        <span class="li-brand-text"><strong>LeadIntel AI</strong><span>HOSPITALITY REVENUE OS</span></span>
      </a>
    </div>

    <% if (closed) { %>
      <p style="font-size:14px;line-height:1.6;color:color-mix(in srgb, var(--color-text) 75%, transparent);">
        Self-serve sign-up is turned off right now. <a href="/login">Sign in</a> if you already have an account, or reach out and we will set one up for you.
      </p>
    <% } else { %>
      <% if (error) { %>
        <p class="li-auth-error"><i class="ph ph-warning-circle"></i><%= error %></p>
      <% } %>

      <form method="post" action="/signup">
        <label for="li-su-company">Company / property name</label>
        <input id="li-su-company" name="company" required value="<%= values.company || '' %>" placeholder="Parakkat Hospitality">

        <label for="li-su-name">Your name</label>
        <input id="li-su-name" name="name" required value="<%= values.name || '' %>" placeholder="Anand P">

        <label for="li-su-email">Work email</label>
        <input id="li-su-email" name="email" type="email" required value="<%= values.email || '' %>" placeholder="you@yourproperty.com">

        <label for="li-su-password">Password</label>
        <input id="li-su-password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters">

        <label style="margin-top:14px;">Plan</label>
        <div class="li-plan-picker">
          <% Object.keys(cfg.tiers).forEach(function (t) { %>
            <label class="li-plan-option">
              <input type="radio" name="plan" value="<%= t %>" <%= values.plan === t ? 'checked' : '' %>>
              <strong><%= cfg.tiers[t].name || t %></strong>
              <span>&#8377;<%= (cfg.tiers[t].price / 100).toLocaleString('en-IN') %>/mo</span>
            </label>
          <% }); %>
        </div>

        <button type="submit">Start 14-day free trial</button>
      </form>

      <p class="li-auth-note">
        No payment is taken to start — there is no billing engine behind this yet, so a plan chosen here is
        recorded but never charged. You can change it any time.
      </p>
      <p class="li-auth-note">Already have an account? <a href="/login">Sign in</a>.</p>
    <% } %>
  </div>
</div>
</body>
</html>
