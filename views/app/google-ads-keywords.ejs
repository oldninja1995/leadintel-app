<%
/* Keyword Analytics — the other half of Google Ads Analytics.
 *
 * Split off rather than made a tab. The account returns four keyword rows and
 * five thousand search terms in a ninety-day window, and both tables were
 * rendering underneath the six campaigns somebody opens that screen to read:
 * about a megabyte of markup below the fold, downloaded and scrolled past every
 * time. A tab would have kept the markup on the page; a screen does not.
 *
 * **Ten rows, then a page of its own.** Every table here previews its first ten
 * rows and says how many it has. `?table=` opens one of them alone, in full,
 * with nothing else competing for the page. That is the same argument made one
 * level down: the top of a table is what you judge it by, and the whole of it
 * is a separate thing to want.
 *
 * Ordered the way the work is done, which is not the hierarchy Google draws:
 *
 *   1. terms with money and nothing to show for it — the worklist
 *   2. the *words* inside those terms — where a negative keyword is decided
 *   3. keywords — what was actually bid on
 *   4. every search term — the full record
 *
 * No table is silently capped: a preview always states the total and links to
 * the rest. A top-25 view of a five-thousand-row report that says nothing about
 * the other 4,975 is the failure mode this is written against.
 *
 * Markup borrows the OTA screen's vocabulary — `li-ota-panel`, `li-ota-scroll`,
 * `li-ota-table`, `li-num` — for the reason google-ads.ejs does: those classes
 * exist and are styled, and inventing unstyled ones renders six bare tables.
 */
const d = data || {};
const num = (v) => (v === null || v === undefined ? '—' : Number(v).toLocaleString('en-IN'));
const txt = (v) => (v === null || v === undefined || v === '' ? '—' : v);
const chip = (v) => String(v || '—').replace(/_/g, ' ').toLowerCase();

const terms = d.searchTerms || [];
const keywords = d.keywords || [];
/* The same keywords, split by the campaign bidding on them — see
   googleAdsPayload in server.js for why the grouping is keyed by campaign and
   keyword rather than by keyword alone. */
const byCampaign = d.keywordsByCampaign || [];
/* The account's current keyword list, and the campaign the reader picked. Not
   the same thing as `byCampaign` above, which is the *measured* keywords —
   see the panel copy and googleAdsPayload for why both exist. */
const live = d.liveCampaigns || [];
const sel = d.selectedCampaign || null;

const words = d.words || [];
const s = d.termSummary || {};

/* The worklist: spend, no conversion. Already flagged per row by the server;
   pulled to the top here because it is the only table on this screen that is
   a list of decisions rather than a record of what happened. */
const wasted = terms.filter((t) => t.wasted);
const wastedWords = words.filter((w) => w.wasted);

const PREVIEW = 10;

/* Which table, if any, the reader asked to see whole. An unknown value shows
   the overview rather than an error — a mistyped query string is not a fault
   worth a page. */
const TABLES = ['wasted', 'words', 'current', 'keywords', 'by-campaign', 'terms'];
const only = TABLES.indexOf(String(d.table || '')) > -1 ? String(d.table) : null;
const shows = (name) => !only || only === name;
const whole = (name) => only === name;

/* The range and any filter, carried on every link out of here so following one
   does not reset the window the reader chose. */
const qs = d.qs || '';
const join = (extra) => (qs ? `${qs}&${extra}` : `?${extra}`);
const rows = (list, name) => (whole(name) ? list : list.slice(0, PREVIEW));

/* Everything already in the query string except the campaign, so the picker's
   form does not drop the range or the open-table state when it submits. A GET
   form replaces the whole query string, which is the trap here. */
const carry = (() => {
  const out = [];
  const seen = new Set(['campaign']);
  for (const pair of String(qs).replace(/^\?/, '').split('&')) {
    if (!pair) continue;
    const [rawName, rawValue = ''] = pair.split('=');
    const name = decodeURIComponent(rawName);
    if (!name || seen.has(name)) continue;
    seen.add(name);
    out.push({ name, value: decodeURIComponent(rawValue.replace(/\+/g, ' ')) });
  }
  return out;
})();

%>

<% if (!d.connected) { %>
  <p class="li-conn-notice li-conn-notice--warn">
    <i class="ph ph-warning-diamond"></i>
    <strong>Google Ads is not connected.</strong>
    Store a credential on the Connections screen — nothing below is invented while it is absent.
  </p>
<% } %>

<p class="li-ota-foot">
  <% if (only) { %>
    <a href="/google-ads/keywords<%= qs %>">Back to Keyword Analytics</a> —
    one table, in full, over <%= txt(d.rangeLabel) %>.
  <% } else { %>
    <a href="/google-ads<%= qs %>">Back to Google Ads Analytics</a> — campaigns, ad groups, ads
    and reservation value. This screen is the keyword and search-term detail beneath them,
    over the same range (<%= txt(d.rangeLabel) %>). Each table below previews ten rows.
  <% } %>
</p>

<!-- What the range holds ---------------------------------------------------->
<% if (!only) { %>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>What this range holds</h2>
    <p>
      Counted from the rows below rather than reported separately, so the summary and the
      tables cannot disagree.
    </p>
  </div>

  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th class="li-num">Keywords</th>
          <th class="li-num">Search terms</th>
          <th class="li-num">Converted</th>
          <th class="li-num">Spent, converted nobody</th>
          <th class="li-num">Cost of that</th>
          <th class="li-num">Words appearing in 2+ terms</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="li-num"><%= num(keywords.length) %></td>
          <td class="li-num"><%= num(s.total) %></td>
          <td class="li-num"><%= num(s.converting) %></td>
          <td class="li-num"><%= num(s.wasted) %></td>
          <td class="li-num"><%= txt(s.wastedSpendText) %></td>
          <td class="li-num"><%= num(words.length) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<!-- Wasted spend, as a worklist ---------------------------------------------->
<% if (shows('wasted')) { %>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Spend with nothing to show for it</h2>
    <p>
      Search terms that cost money and converted nobody, most expensive first. Every row is a
      candidate for a negative keyword — this is the one table on the screen that is a list of
      decisions rather than a record.
    </p>
  </div>

  <% if (!wasted.length) { %>
    <p class="li-ota-foot">
      <% if (!terms.length) { %>
        No search term rows in this range — the search terms report is what carries them.
      <% } else { %>
        Every search term that spent in this range converted at least once.
      <% } %>
    </p>
  <% } else { %>
  <p class="li-ota-foot">
    <strong><%= num(wasted.length) %></strong> terms<% if (s.wastedSpendText) { %>,
    costing <strong><%= s.wastedSpendText %></strong><% } %>.
    <% if (!whole('wasted') && wasted.length > PREVIEW) { %>
      Showing the <%= PREVIEW %> most expensive.
    <% } %>
  </p>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Search term</th><th>Ad group</th><th>Status</th>
          <th class="li-num">Spend</th><th class="li-num">Impr.</th>
          <th class="li-num">Clicks</th><th class="li-num">CTR</th><th class="li-num">CPC</th>
        </tr>
      </thead>
      <tbody>
        <% rows(wasted, 'wasted').forEach((t) => { %>
          <tr>
            <td><%= txt(t.term) %></td>
            <td><%= txt(t.adgroup) %></td>
            <td><%= chip(t.termStatus) %></td>
            <td class="li-num"><%= txt(t.spendText) %></td>
            <td class="li-num"><%= num(t.impressions) %></td>
            <td class="li-num"><%= num(t.clicks) %></td>
            <td class="li-num"><%= txt(t.ctr) %></td>
            <td class="li-num"><%= txt(t.cpcText) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (!whole('wasted') && wasted.length > PREVIEW) { %>
    <p class="li-ota-foot">
      <a href="/google-ads/keywords<%= join('table=wasted') %>">
        View all <%= num(wasted.length) %> wasted terms
      </a> &rarr;
    </p>
  <% } %>
  <% } %>
</section>
<% } %>

<!-- Words, not phrases ------------------------------------------------------->
<% if (shows('words')) { %>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Where the money goes, by word</h2>
    <p>
      A search term report is mostly one-off phrases: the same waste appears as fifty
      near-identical rows, each too small to notice. Rolling spend up by word is what makes a
      negative keyword obvious — one token across a dozen non-converting terms is the thing
      worth excluding, and no per-row view surfaces it.
    </p>
  </div>

  <% if (!words.length) { %>
    <p class="li-ota-foot">No word appears in more than one search term in this range.</p>
  <% } else { %>
  <p class="li-ota-foot">
    <%= num(words.length) %> words, each appearing in two or more terms.
    <strong><%= num(wastedWords.length) %></strong> of them have converted nobody.
    <% if (!whole('words') && words.length > PREVIEW) { %>Showing the top <%= PREVIEW %> by spend.<% } %>
    Not stemmed and not stopword-filtered beyond the shortest tokens: this is the account's own
    vocabulary, and guessing which words are meaningful is how a tool starts hiding the answer.
  </p>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Word</th><th class="li-num">Terms</th>
          <th class="li-num">Spend</th><th class="li-num">Clicks</th><th class="li-num">Conv.</th>
        </tr>
      </thead>
      <tbody>
        <% rows(words, 'words').forEach((w) => { %>
          <tr>
            <td><%= txt(w.word) %><% if (w.wasted) { %> <span class="li-chip">wasted</span><% } %></td>
            <td class="li-num"><%= num(w.terms) %></td>
            <td class="li-num"><%= txt(w.spendText) %></td>
            <td class="li-num"><%= num(w.clicks) %></td>
            <td class="li-num"><%= num(w.conversions) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (!whole('words') && words.length > PREVIEW) { %>
    <p class="li-ota-foot">
      <a href="/google-ads/keywords<%= join('table=words') %>">
        View all <%= num(words.length) %> words
      </a> &rarr;
    </p>
  <% } %>
  <p class="li-ota-foot">
    Spend is counted once per term per word, so these columns deliberately do <strong>not</strong>
    sum to account spend — a two-word term contributes its cost to both of its words. The
    comparison is between words, not against a total.
  </p>
  <% } %>
</section>
<% } %>

<!-- Current keywords, by campaign ---------------------------------------------->
<% if (shows('current') && live.length) { %>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Keywords in the account</h2>
    <p>
      What each campaign is bidding on <strong>right now</strong> — the account's own keyword
      list, enabled and paused alike. This does not narrow with the range above it, and cannot:
      "what are we bidding on" has no window, and Google does not report what the list looked
      like in a past month. The spend beside each keyword does follow the range, so a keyword
      with a dash did not spend nothing — it had no delivery Google reported in this window.
      That is the difference between this table and the measured one below it, which can only
      ever show keywords that ran.
    </p>
  </div>

  <%# A GET form, so the picker works with JavaScript switched off and the chosen
      campaign lives in the URL — which makes it linkable and survives a reload. %>
  <form method="get" action="/google-ads/keywords" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:12px 0;">
    <% carry.forEach(function (p) { %><input type="hidden" name="<%= p.name %>" value="<%= p.value %>"><% }); %>
    <label for="li-kw-campaign" style="font-size:11.5px; color:var(--color-neutral-500);">Campaign</label>
    <%# No inline `onchange`: this app's CSP is `script-src 'self'` with no
        'unsafe-inline', so a handler written as an attribute is silently never
        run — the select changed, the form never submitted, and the panel below
        went on describing the campaign that was already loaded. The submit is
        wired in app-ui.js instead, and the button beside it is no longer inside
        <noscript> so the control works even if that never runs. %>
    <select id="li-kw-campaign" name="campaign" data-li-autosubmit
            style="font: inherit; font-size:12px; padding:6px 10px; border-radius:8px; background:var(--color-surface); color:var(--color-neutral-200); border:1px solid var(--color-neutral-800);">
      <% live.forEach(function (c) { %>
        <option value="<%= c.campaignId %>" <%= sel && String(sel.campaignId) === String(c.campaignId) ? 'selected' : '' %>>
          <%= txt(c.campaign) %> — <%= c.count %> keyword<%= c.count === 1 ? '' : 's' %><% if (c.paused) { %>, <%= c.paused %> paused<% } %>
        </option>
      <% }); %>
    </select>
    <button type="submit" style="font: inherit; font-size:12px; padding:6px 12px; border-radius:8px; border:1px solid var(--color-neutral-800); background:transparent; color:var(--color-neutral-300); cursor:pointer;">Show</button>
    <span style="font-size:11px; color:var(--color-neutral-600);">
      <%= live.length %> campaign<%= live.length === 1 ? '' : 's' %> with keywords
    </span>
  </form>

  <% if (sel) { %>
    <div class="li-ota-panel-head">
      <h3 style="font-size:13px; margin:0;">
        <%= txt(sel.campaign) %>
        <span class="li-chip"><%= sel.count %> keyword<%= sel.count === 1 ? '' : 's' %></span>
        <% if (sel.matchMix) { %><span class="li-chip"><%= sel.matchMix %></span><% } %>
        <% if (sel.status) { %><span class="li-chip"><%= chip(sel.status) %></span><% } %>
        <% if (sel.channelType) { %><span class="li-chip"><%= chip(sel.channelType) %></span><% } %>
      </h3>
      <p>
        <%= sel.measured %> of <%= sel.count %> had delivery Google reported in this range<% if (sel.spendText) { %>,
        costing <%= sel.spendText %><% } %>. The rest are in the account and were quiet — a paused
        keyword and one that simply got no impressions both read as a dash, which the status
        column tells apart.
      </p>
    </div>
    <div class="li-ota-scroll">
      <table class="li-ota-table">
        <thead>
          <tr>
            <th>Keyword</th><th>Match</th><th>Status</th><th>Ad group</th>
            <th class="li-num">Spend</th><th class="li-num">Impressions</th>
            <th class="li-num">Clicks</th><th class="li-num">CTR</th><th class="li-num">CPC</th>
          </tr>
        </thead>
        <tbody>
          <% rows(sel.keywords, 'current').forEach((k) => { %>
            <tr>
              <td><%= txt(k.keyword) %></td>
              <td><span class="li-chip"><%= chip(k.matchType) %></span></td>
              <td><span class="li-chip"><%= chip(k.status) %></span></td>
              <td><%= txt(k.adgroup) %></td>
              <td class="li-num" title="<%= k.measured ? 'Spend in the selected range.' : 'No delivery reported for this keyword in the selected range — it is in the account and was quiet, which is not the same as spending nothing.' %>"><%= txt(k.spendText) %></td>
              <td class="li-num"><%= k.measured ? num(k.impressions) : '—' %></td>
              <td class="li-num"><%= k.measured ? num(k.clicks) : '—' %></td>
              <td class="li-num"><%= txt(k.ctr) %></td>
              <td class="li-num"><%= txt(k.cpcText) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (!whole('current') && sel.keywords.length > PREVIEW) { %>
      <p class="li-ota-foot">
        <%= num(sel.keywords.length) %> keywords in this campaign. Showing the <%= PREVIEW %> with
        the most spend —
        <a href="/google-ads/keywords<%= join('table=current&campaign=' + encodeURIComponent(sel.campaignId)) %>">view the whole list</a> &rarr;
      </p>
    <% } %>
  <% } %>
</section>
<% } %>

<!-- Keywords by campaign, as measured ------------------------------------------>
<% if (shows('by-campaign') && byCampaign.length) { %>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Keywords by campaign</h2>
    <p>
      What each campaign is actually bidding on, and on what terms. Match type is the setting
      that decides how far Google may stray from the words: <strong>exact</strong> is that
      phrase and its close variants, <strong>phrase</strong> is that phrase inside a longer one,
      and <strong>broad</strong> lets Google serve anything it reads as related — which is where
      a search-term report fills with strangers. A campaign bidding entirely broad and a campaign
      bidding entirely exact are two different accounts, and the mix beside each name says which
      one this is.
    </p>
  </div>

  <% byCampaign.forEach((c) => { %>
    <div class="li-ota-panel-head" style="margin-top:14px;">
      <h3 style="font-size:13px; margin:0;">
        <%= txt(c.campaign) %>
        <span class="li-chip"><%= c.count %> keyword<%= c.count === 1 ? '' : 's' %></span>
        <% if (c.matchMix) { %><span class="li-chip"><%= c.matchMix %></span><% } %>
      </h3>
      <p>
        <%= txt(c.spendText) %> on keywords · <%= num(c.impressions) %> impressions ·
        <%= num(c.clicks) %> clicks<% if (c.ctr) { %> · <%= c.ctr %> CTR<% } %>
        <% if (!c.named && c.campaignId) { %>
          · keyword rows in this range name this campaign id, and no spend row does, so it cannot be named
        <% } else if (!c.named) { %>
          · these keyword rows carry no campaign id at all, so they cannot be attributed to one
        <% } %>
      </p>
    </div>
    <div class="li-ota-scroll">
      <table class="li-ota-table">
        <thead>
          <tr>
            <th>Keyword</th><th>Match</th><th class="li-num">Quality</th>
            <th class="li-num">Spend</th><th class="li-num">Impressions</th>
            <th class="li-num">Clicks</th><th class="li-num">CTR</th><th class="li-num">CPC</th>
            <th class="li-num">Conv.</th><th class="li-num">Cost/conv.</th>
          </tr>
        </thead>
        <tbody>
          <% rows(c.keywords, 'by-campaign').forEach((k) => { %>
            <tr>
              <td><%= txt(k.keyword) %></td>
              <td><span class="li-chip"><%= chip(k.matchType) %></span></td>
              <td class="li-num"><%= txt(k.qualityScore) %></td>
              <td class="li-num"><%= txt(k.spendText) %></td>
              <td class="li-num"><%= num(k.impressions) %></td>
              <td class="li-num"><%= num(k.clicks) %></td>
              <td class="li-num"><%= txt(k.ctr) %></td>
              <td class="li-num"><%= txt(k.cpcText) %></td>
              <td class="li-num"><%= num(k.conversions) %></td>
              <td class="li-num"><%= txt(k.cplText) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (!whole('by-campaign') && c.keywords.length > PREVIEW) { %>
      <p class="li-ota-foot">
        <%= num(c.keywords.length) %> keywords in this campaign. Showing the <%= PREVIEW %>
        highest-spending —
        <a href="/google-ads/keywords<%= join('table=by-campaign') %>">view every campaign's list in full</a> &rarr;
      </p>
    <% } %>
  <% }); %>

  <p class="li-ota-foot">
    A keyword bid in two campaigns appears under both, with each campaign's own spend against it.
    Collapsing them into one row would hide which of the two is the expensive one, which is the
    question this table is opened to answer.
  </p>
</section>
<% } %>

<!-- Keywords ----------------------------------------------------------------->
<% if (shows('keywords')) { %>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Keywords</h2>
    <p>
      Shown verbatim — a keyword is the literal string that was bid on, and match type is what
      decides how far Google may stray from it. What people actually typed is the search terms
      report; these two answer different questions and are the whole reason both exist.
    </p>
  </div>

  <% if (d.keywordsNotApplicable) { %>
    <p class="li-ota-foot li-ota-foot--warn">
      Not applicable — <%= d.keywordsNotApplicable %>. Keywords exist only on Search campaigns,
      so an empty table here would claim there were none rather than that the concept does not apply.
    </p>
  <% } else if (!keywords.length) { %>
    <p class="li-ota-foot">No keyword rows in this range.</p>
  <% } else { %>
  <% if (!whole('keywords') && keywords.length > PREVIEW) { %>
    <p class="li-ota-foot">
      <%= num(keywords.length) %> keywords. Showing the <%= PREVIEW %> highest-spending.
    </p>
  <% } %>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Keyword</th><th>Match</th><th class="li-num">Quality</th>
          <th class="li-num">Spend</th><th class="li-num">Impressions</th>
          <th class="li-num">Clicks</th><th class="li-num">CTR</th><th class="li-num">CPC</th>
          <th class="li-num">Conv.</th><th class="li-num">Conv. rate</th><th class="li-num">Cost/conv.</th>
        </tr>
      </thead>
      <tbody>
        <% rows(keywords, 'keywords').forEach((k) => { %>
          <tr>
            <td><%= txt(k.keyword) %></td>
            <td><span class="li-chip"><%= chip(k.matchType) %></span></td>
            <td class="li-num"><%= txt(k.qualityScore) %></td>
            <td class="li-num"><%= txt(k.spendText) %></td>
            <td class="li-num"><%= num(k.impressions) %></td>
            <td class="li-num"><%= num(k.clicks) %></td>
            <td class="li-num"><%= txt(k.ctr) %></td>
            <td class="li-num"><%= txt(k.cpcText) %></td>
            <td class="li-num"><%= num(k.conversions) %></td>
            <td class="li-num"><%= txt(k.convRate) %></td>
            <td class="li-num"><%= txt(k.cplText) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (!whole('keywords') && keywords.length > PREVIEW) { %>
    <p class="li-ota-foot">
      <a href="/google-ads/keywords<%= join('table=keywords') %>">
        View all <%= num(keywords.length) %> keywords
      </a> &rarr;
    </p>
  <% } %>
  <p class="li-ota-foot">
    Cost per <em>conversion</em>, not per lead: Google's conversion count sums every action the
    account defines — a booking enquiry and a phone click alike. Until one of them is nominated
    as the lead action, this is not a cost per lead.
  </p>
  <% } %>
</section>
<% } %>

<!-- Every search term -------------------------------------------------------->
<% if (shows('terms')) { %>
<section class="li-ota-panel">
  <div class="li-ota-panel-head">
    <h2>Search terms</h2>
    <p>
      What people actually typed, as opposed to what was bid on. Sorted by spend — the long
      tail is where the word rollup above gets its evidence, which is why the whole report is
      reachable rather than capped.
    </p>
  </div>

  <% if (!terms.length) { %>
    <p class="li-ota-foot">No search term rows in this range.</p>
  <% } else { %>
  <p class="li-ota-foot">
    <strong><%= num(terms.length) %></strong> terms.
    <% if (!whole('terms') && terms.length > PREVIEW) { %>Showing the <%= PREVIEW %> highest-spending.<% } %>
  </p>
  <div class="li-ota-scroll">
    <table class="li-ota-table">
      <thead>
        <tr>
          <th>Search term</th><th>Ad group</th><th>Status</th>
          <th class="li-num">Spend</th><th class="li-num">Impr.</th>
          <th class="li-num">Clicks</th><th class="li-num">CPC</th><th class="li-num">CTR</th>
          <th class="li-num">Conv.</th><th class="li-num">Conv. rate</th><th class="li-num">Cost/conv.</th>
        </tr>
      </thead>
      <tbody>
        <% rows(terms, 'terms').forEach((t) => { %>
          <tr>
            <td><%= txt(t.term) %><% if (t.wasted) { %> <span class="li-chip">wasted</span><% } %></td>
            <td><%= txt(t.adgroup) %></td>
            <td><%= chip(t.termStatus) %></td>
            <td class="li-num"><%= txt(t.spendText) %></td>
            <td class="li-num"><%= num(t.impressions) %></td>
            <td class="li-num"><%= num(t.clicks) %></td>
            <td class="li-num"><%= txt(t.cpcText) %></td>
            <td class="li-num"><%= txt(t.ctr) %></td>
            <td class="li-num"><%= num(t.conversions) %></td>
            <td class="li-num"><%= txt(t.convRate) %></td>
            <td class="li-num"><%= txt(t.cplText) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (!whole('terms') && terms.length > PREVIEW) { %>
    <p class="li-ota-foot">
      <a href="/google-ads/keywords<%= join('table=terms') %>">
        View all <%= num(terms.length) %> search terms
      </a> &rarr;
    </p>
  <% } %>
  <% } %>
</section>
<% } %>
